+            // items taken or fetched in this session are in the local store; else ask the server for the Objects folder
+            var hit = c.Inventory.Store.Items.Values.Select(n => n.Data).FirstOrDefault(ok) as InventoryItem;
+            if (hit != null) return hit;
+            var folder = c.Inventory.FindFolderForType(AssetType.Object);
