+    /// <summary>One-time pairing invitations: the bot IMs a person a chat link carrying a code; their HUD then asks the bot
+    /// ("slbm-pairwith|code|url" by object IM), the bot checks the code belongs to the HUD's owner and sends the pairing
+    /// line to the HUD's (https) address. An overheard code is useless to anybody else's HUD; each code works once.</summary>
+    public static class CompanionInvites
+    {
+        static readonly ConcurrentDictionary<string, (UUID avatar, string line, DateTime until)> pending = new();
+        static readonly HttpClient http = new() { Timeout = TimeSpan.FromSeconds(20) };
+
+        public static void Add(string code, UUID avatar, string line, TimeSpan valid) =>
+            pending[code] = (avatar, line, DateTime.Now + valid);
+
+        /// <summary>Called for an object IM starting with slbm-pairwith|; ownerId = the HUD's owner.</summary>
+        public static void Redeem(GridClient c, UUID ownerId, string message)
+        {
+            var p = message.Split('|');
+            if (p.Length < 3) return;
+            string code = p[1], url = string.Join("|", p.Skip(2));
+            string who = CompanionNames.Get(c, ownerId, 3000);
+            if (!pending.TryGetValue(code, out var inv) || inv.until < DateTime.Now || inv.avatar != ownerId)
+            {
+                LogFormater.Warn("[Companion] pairing request from " + (who == "" ? ownerId.ToString() : who) + " with an unknown, used or someone else's code");
+                return;
+            }
+            if (!url.StartsWith("https://"))
+            {
+                LogFormater.Warn("[Companion] pairing request without a secure HUD address - not answered");
+                return;
+            }
+            pending.TryRemove(code, out _);
+            Task.Run(async () =>
+            {
+                try
+                {
+                    var form = new FormUrlEncodedContent(new Dictionary<string, string> { { "command", "CompanionPairing" }, { "reply", inv.line + "\n" + code } });
+                    var r = await http.PostAsync(url, form);
+                    string body = await r.Content.ReadAsStringAsync();
+                    LogFormater.Info("[Companion] pairing sent to the HUD of " + who + ": " + body);
+                    CompanionEvents.Add("hud-paired", ownerId, who, c.Network.CurrentSim?.Name, body);
+                }
+                catch (Exception e) { LogFormater.Warn("[Companion] pairing could not reach the HUD: " + e.Message); }
+            });
+        }
+    }
