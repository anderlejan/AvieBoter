+        static string ReadFileFromEnv(string var)
+        {
+            string p = Environment.GetEnvironmentVariable(var);
+            if (string.IsNullOrEmpty(p))
+            {
+                // started without the app's settings: the app keeps the HUD scripts in ..\wwwroot\hud next to the bot folder
+                string f = var == "SLBM_HUD_UPDATER" ? "AvieBoterHUDUpdater.lsl" : var == "SLBM_HUD_MENU" ? "AvieBoterHUDMenu.lsl" : var == "SLBM_HUD_CAM" ? "AvieBoterHUDCam.lsl" : "AvieBoterHUD.lsl";
+                p = System.IO.Path.Combine(AppContext.BaseDirectory, "..", "wwwroot", "hud", f);
+            }
+            try { return string.IsNullOrEmpty(p) || !System.IO.File.Exists(p) ? null : System.IO.File.ReadAllText(p); } catch { return null; }
+        }
