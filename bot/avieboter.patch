+    /// <summary>Born dates of avatars on the radar (profile data, as viewers' radars show the age). Asked a few at a
+    /// time while the Radar is open, each avatar once.</summary>
+    public static class CompanionAges
+    {
+        static readonly ConcurrentDictionary<UUID, string> born = new();
+        static readonly ConcurrentDictionary<UUID, DateTime> asked = new();
+        static GridClient hooked;
+        public static int YoungDays = int.TryParse(Environment.GetEnvironmentVariable("SLBM_YOUNG_DAYS"), out int yd) ? yd : 0;
+        static readonly ConcurrentDictionary<UUID, (string name, string region)> toCheck = new();
+        static readonly ConcurrentDictionary<UUID, DateTime> alerted = new();
+
+        public static int? Days(string bornOn) =>
+            DateTime.TryParseExact(bornOn ?? "", "M/d/yyyy", System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out DateTime b)
+                ? (int)(DateTime.UtcNow.Date - b.Date).TotalDays : null;
+
+        /// <summary>An avatar came into the bot's region: with the alert on, learn its age (from the profile) and
+        /// raise event "young" when it is younger than YoungDays (once a day per avatar).</summary>
+        public static void Arrived(GridClient c, UUID id, string name, string region)
+        {
+            if (YoungDays <= 0 || c == null) return;
+            if (born.TryGetValue(id, out string b)) { Judge(id, name, region, b); return; }
+            toCheck[id] = (name, region);
+            Born(c, id);
+        }
+
+        static void Judge(UUID id, string name, string region, string b)
+        {
+            int? d = Days(b);
+            if (d == null || d >= YoungDays) return;
+            if (alerted.TryGetValue(id, out DateTime t) && DateTime.Now - t < TimeSpan.FromHours(20)) return;
+            alerted[id] = DateTime.Now;
+            CompanionEvents.Add("young", id, name, region, d + (d == 1 ? " day" : " days"));
+        }
+
+        /// <summary>Asks again for avatars still waiting for their age (a few at a time); called with the radar.</summary>
+        public static void Tick(GridClient c)
+        {
+            if (YoungDays <= 0 || c == null) { toCheck.Clear(); return; }
+            foreach (var kv in toCheck.ToArray())
+            {
+                if (born.TryGetValue(kv.Key, out string b)) { toCheck.TryRemove(kv.Key, out _); Judge(kv.Key, kv.Value.name, kv.Value.region, b); }
+                else Born(c, kv.Key);
+            }
+        }
+
+        public static string Born(GridClient c, UUID id)
+        {
+            if (born.TryGetValue(id, out string b)) return b;
+            if (c == null) return "";
+            if (hooked != c)
+            {
+                hooked = c;
+                c.Avatars.AvatarPropertiesReply += (s, e) =>
+                {
+                    if (string.IsNullOrEmpty(e.Properties.BornOn)) return;
+                    born[e.AvatarID] = e.Properties.BornOn;
+                    if (toCheck.TryRemove(e.AvatarID, out var w)) Judge(e.AvatarID, w.name == "" ? CompanionNames.Get(null, e.AvatarID) : w.name, w.region, e.Properties.BornOn);
+                };
+            }
+            if (asked.Count(kv => DateTime.Now - kv.Value < TimeSpan.FromSeconds(3)) < 5
+                && (!asked.TryGetValue(id, out DateTime t) || DateTime.Now - t > TimeSpan.FromMinutes(10)))
+            {
+                asked[id] = DateTime.Now;
+                c.Avatars.RequestAvatarProperties(id);
+            }
+            return "";
+        }
+    }
+}
