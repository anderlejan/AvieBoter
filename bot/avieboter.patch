+                mine = owner == c.Self.AgentID,
+                dist = Math.Round(Vector3.Distance(me, p.Position), 1),
+                x = Math.Round(p.Position.X, 1), y = Math.Round(p.Position.Y, 1), z = Math.Round(p.Position.Z, 1),
