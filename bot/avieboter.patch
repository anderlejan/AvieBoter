+        /// <summary>ManagedImage → SKBitmap (LibreMetaverse's ExportBitmap treats raw pixels as an encoded file and gives null).</summary>
+        static SkiaSharp.SKBitmap Bitmap(OpenMetaverse.Imaging.ManagedImage im)
+        {
+            int n = im.Width * im.Height;
+            var raw = new byte[n * 4];
+            bool alpha = (im.Channels & OpenMetaverse.Imaging.ManagedImage.ImageChannels.Alpha) != 0 && im.Alpha != null;
+            byte[] r = im.Red ?? im.Alpha, g = im.Green ?? r, b = im.Blue ?? r;
+            for (int i = 0; i < n; i++)
+            {
+                raw[i * 4 + 0] = b[i]; raw[i * 4 + 1] = g[i]; raw[i * 4 + 2] = r[i];
+                raw[i * 4 + 3] = alpha ? im.Alpha[i] : (byte)255;
+            }
+            var bmp = new SkiaSharp.SKBitmap(new SkiaSharp.SKImageInfo(im.Width, im.Height, SkiaSharp.SKColorType.Bgra8888, SkiaSharp.SKAlphaType.Unpremul));
+            System.Runtime.InteropServices.Marshal.Copy(raw, 0, bmp.GetPixels(), raw.Length);
+            return bmp;
+        }
