+        /// <summary>Wears the one anchor at Avatar Center, 0.7 m above the centre (about head height: where the camera
+        /// looks; straight above, so turning does not move it). Extra worn anchors come off.</summary>
+        /// <summary>Every item in the bot's inventory outside the Trash (folder by folder, at most 60 s), and the links in
+        /// its current outfit folder.</summary>
+        List<InventoryItem> AllItems(UUID trash, out List<InventoryItem> cofLinks)
+        {
+            var c = GetClient();
+            var items = new List<InventoryItem>();
+            cofLinks = new List<InventoryItem>();
+            var cof = c.Inventory.FindFolderForType(FolderType.CurrentOutfit);
+            var todo = new Queue<UUID>();
+            todo.Enqueue(c.Inventory.Store.RootFolder.UUID);
+            DateTime until = DateTime.Now.AddSeconds(60);
+            int folders = 0;
+            while (todo.Count > 0 && DateTime.Now < until && folders < 3000)
+            {
+                var f = todo.Dequeue();
+                folders++;
+                foreach (var b in c.Inventory.FolderContents(f, c.Self.AgentID, true, true, InventorySortOrder.ByName, TimeSpan.FromSeconds(15)) ?? [])
+                {
+                    if (b is InventoryFolder sub) { if (sub.UUID != trash) todo.Enqueue(sub.UUID); }
+                    else if (b is InventoryItem it) { if (f == cof) cofLinks.Add(it); else items.Add(it); }
+                }
+            }
+            LogFormater.Info("[Companion] looked through " + folders + " inventory folders for camera anchors");
+            return items;
+        }
