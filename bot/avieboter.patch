+        static void RadarTick()
+        {
+            var c = radarClient;
+            try
+            {
+                var sim = c?.Network?.CurrentSim;
+                if (sim == null || !c.Network.Connected) return;
+                var now = new HashSet<UUID>(sim.AvatarPositions.Keys.Where(k => k != c.Self.AgentID));
+                foreach (var av in sim.ObjectsAvatars.Values) if (av.ID != c.Self.AgentID && av.ID != UUID.Zero) now.Add(av.ID);
+                if (presentHandle != sim.Handle)
+                {
+                    // the bot changed region: start a fresh picture instead of reporting everybody as coming and going
+                    presentHandle = sim.Handle;
+                    present = now;
+                    CompanionEvents.Add("region", c.Self.AgentID, c.Self.Name, sim.Name, now.Count + " avatars here");
+                    foreach (var id in now.Take(40)) CompanionAges.Arrived(c, id, CompanionNames.Get(null, id), sim.Name);   // names from the cache only: no waiting here
+                    return;
+                }
+                foreach (var id in now.Where(i => !present.Contains(i)))
+                {
+                    string n = CompanionNames.Get(c, id);
+                    CompanionEvents.Add("arrive", id, n, sim.Name);
+                    CompanionAges.Arrived(c, id, n, sim.Name);
+                }
+                CompanionAges.Tick(c);
+                foreach (var id in present.Where(i => !now.Contains(i))) CompanionEvents.Add("leave", id, CompanionNames.Get(c, id), sim.Name);
+                present = now;
+            }
+            catch (Exception e) { LogFormater.Warn("[Companion] radar: " + e.Message); }
+        }
