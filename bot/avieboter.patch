+    /// <summary>Where avatars are: precise for the ones the bot sees, coarse (whole region and neighbours) for the rest.</summary>
+    public static class CompanionRadarData
+    {
+        public record Seen(UUID Id, string Name, ulong Handle, string Region, Vector3 Pos, bool Sitting, bool Precise, Quaternion Rot);
+
+        public static Vector3d Global(ulong handle, Vector3 local)
+        {
+            Utils.LongToUInts(handle, out uint gx, out uint gy);
+            return new Vector3d(gx + local.X, gy + local.Y, local.Z);
+        }
+
+        public static List<Seen> All(GridClient c)
+        {
+            var list = new Dictionary<UUID, Seen>();
+            List<Simulator> sims;
+            lock (c.Network.Simulators) sims = c.Network.Simulators.ToList();
+            foreach (var s in sims)
+            {
+                foreach (var kv in s.AvatarPositions)
+                {
+                    if (kv.Key == c.Self.AgentID || list.ContainsKey(kv.Key)) continue;
+                    list[kv.Key] = new Seen(kv.Key, CompanionNames.Get(c, kv.Key), s.Handle, s.Name, kv.Value, false, false, Quaternion.Identity);
+                }
+                foreach (var av in s.ObjectsAvatars.Values)
+                {
+                    if (av.ID == c.Self.AgentID || av.ID == UUID.Zero) continue;
+                    CompanionNames.Note(av.ID, av.Name);
+                    Vector3 p = av.Position;
+                    bool sitting = av.ParentID != 0;
+                    if (sitting)
+                    {
+                        if (s.ObjectsPrimitives.TryGetValue(av.ParentID, out Primitive seat))
+                        {
+                            Vector3 sp = seat.Position;
+                            Quaternion sr = seat.Rotation;
+                            if (seat.ParentID != 0 && s.ObjectsPrimitives.TryGetValue(seat.ParentID, out Primitive root))
+                            {
+                                sp = root.Position + seat.Position * root.Rotation;
+                                sr = root.Rotation * seat.Rotation;
+                            }
+                            p = sp + av.Position * sr;
+                        }
+                        else if (list.TryGetValue(av.ID, out Seen coarse)) p = coarse.Pos;
+                    }
+                    list[av.ID] = new Seen(av.ID, string.IsNullOrEmpty(av.Name) ? CompanionNames.Get(c, av.ID) : av.Name, s.Handle, s.Name, p, sitting, true, av.Rotation);
+                }
+            }
+            return list.Values.ToList();
+        }
+
+        public static Seen Find(GridClient c, UUID id) => All(c).FirstOrDefault(a => a.Id == id);
+    }
