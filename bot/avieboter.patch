+// AvieBoter patch: moving the bot by hand from the app's Puppeteer window, like a viewer's move controls. Each command
+// holds a direction for a short time; the window repeats it while a button or key is held, so the bot stops by itself
+// when the window or the connection goes away.
+using OpenMetaverse;
+using SecondBotEvents.Services;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+
+namespace SecondBotEvents.Commands
+{
+    [ClassInfo("Move controls for the AvieBoter app's Puppeteer window")]
+    public class CompanionPuppet(EventsSecondBot setmaster) : CommandsAPI(setmaster)
+    {
+        static readonly object gate = new();
+        static readonly Dictionary<string, DateTime> held = new();
+        static Timer tick;
+        static GridClient client;
+        static double heading;          // radians, 0 = east, counter-clockwise
+        static DateTime lastMove = DateTime.MinValue;
+        static bool moving;
+        static Vector3 endPos;          // where the last hand movement ended: the bot still faces 'heading' there
+        static bool settled = true;     // endPos is where it came to rest (it slides on a little after the keys)
+
+        // Viewers draw another avatar's body turning only in steps (it may stay up to ~45° behind while standing) and
+        // its head straight with the body unless the avatar says where it looks. So, like a viewer, the bot tells
+        // everyone it looks ahead the way it faces: the head turns at once and the body follows.
+        static readonly UUID lookId = UUID.Random();
+        static bool looking;
+        static double lookHeading;
+        static Vector3 lookPos;
+        static DateTime lookSent = DateTime.MinValue;
+        static Timer watch;
+
+        // diagnostics: what the bot sends and what the region reports back about its avatar
+        static readonly List<string> trace = new();
+        static DateTime traceUntil = DateTime.MinValue, traceStart;
+        static GridClient traced;
+        static void Trace(string src, double yaw, Vector3 p, Vector3 v)
+        {
+            if (DateTime.Now > traceUntil) return;
+            lock (trace) if (trace.Count < 2000) trace.Add(string.Format(System.Globalization.CultureInfo.InvariantCulture,
+                "{0:0} {1} {2:0.0} {3:0.00} {4:0.00} {5:0.00} {6:0.00}", (DateTime.Now - traceStart).TotalMilliseconds, src, yaw * 180 / Math.PI, p.X, p.Y, v.X, v.Y));
+        }
+
+        [About("Diagnostics for the Puppeteer: start records for 30 s what the bot sends and what the region reports about it; get returns it")]
+        [ReturnHints("lines: ms source yaw x y vx vy")]
+        [ArgHints("mode", "start or get", "Text", "get")]
+        [CmdTypeGet()]
+        public object CompanionPuppetTrace(string mode)
+        {
+            var c = GetClient();
+            if (c == null) return Failure("not online");
+            if ((mode ?? "").Trim().ToLowerInvariant() == "start")
+            {
+                if (traced != c)
+                {
+                    traced = c;
+                    c.Objects.TerseObjectUpdate += (o, e) => { if (e.Update.LocalID == c.Self.LocalID) Trace("sim", Yaw(e.Update.Rotation), e.Update.Position, e.Update.Velocity); };
+                    c.Objects.AvatarUpdate += (o, e) => { if (e.Avatar.LocalID == c.Self.LocalID) Trace("full", Yaw(e.Avatar.Rotation), e.Avatar.Position, e.Avatar.Velocity); };
+                    c.Avatars.ViewerEffectLookAt += (o, e) =>
+                    {
+                        if (e.SourceID != c.Self.AgentID) return;
+                        Utils.LongToUInts(c.Network.CurrentSim?.Handle ?? 0, out uint gx, out uint gy);
+                        var t = new Vector3((float)(e.TargetPosition.X - gx), (float)(e.TargetPosition.Y - gy), (float)e.TargetPosition.Z);
+                        Trace("echo-" + e.LookType, 0, t, Vector3.Zero);
+                    };
+                }
+                lock (trace) trace.Clear();
+                traceStart = DateTime.Now; traceUntil = DateTime.Now.AddSeconds(30);
+                return BasicReply("tracing");
+            }
+            lock (trace) return BasicReply(string.Join(";", trace));
+        }
+
+        static void Look(GridClient c, bool force)
+        {
+            var pos = c.Self.SimPosition;
+            bool same = Math.Abs(Math.IEEERemainder(heading - lookHeading, 2 * Math.PI)) < 0.03 && Vector3.Distance(pos, lookPos) < 0.3f;
+            if (!force && looking && same && DateTime.Now - lookSent < TimeSpan.FromSeconds(10)) return;
+            if (!force && looking && DateTime.Now - lookSent < TimeSpan.FromMilliseconds(200)) return;
+            var ahead = new Vector3d(Math.Cos(heading) * 20, Math.Sin(heading) * 20, 0.6);   // far, so a stale or sliding position hardly turns the head
+            c.Self.LookAtEffect(c.Self.AgentID, UUID.Zero, c.Self.GlobalPosition + ahead, LookAtType.Focus, lookId);
+            Trace("look", heading, pos, Vector3.Zero);
+            looking = true; lookHeading = heading; lookPos = pos; lookSent = DateTime.Now;
+            watch ??= new Timer(_ => Watch(), null, Timeout.Infinite, Timeout.Infinite);
+            watch.Change(1000, 1000);
+        }
+
+        static void Unlook(GridClient c)
+        {
+            if (!looking) return;
+            looking = false;
+            watch?.Change(Timeout.Infinite, Timeout.Infinite);
+            try { c.Self.LookAtEffect(c.Self.AgentID, UUID.Zero, Vector3d.Zero, LookAtType.None, lookId); } catch { }
+            Trace("unlook", heading, c.Self.SimPosition, Vector3.Zero);
+        }
+
+        /// <summary>Keeps the look while the bot stands where it was left (repeated now and then for people who arrive);
+        /// drops it once something else moved it, sat it down or took it away.</summary>
+        static void Watch()
+        {
+            var c = client;
+            if (c == null) return;
+            try
+            {
+                lock (gate)
+                {
+                    if (moving || !looking) return;
+                    if (!settled && DateTime.Now - lastMove < TimeSpan.FromSeconds(5) && c.Self.Velocity.Length() > 0.2f) return;   // still sliding
+                    if (!settled) { settled = true; endPos = c.Self.SimPosition; Look(c, true); return; }
+                    if (c.Network?.CurrentSim == null || c.Self.SittingOn != 0 || !StillThere(c)) Unlook(c);
+                    else Look(c, false);
+                }
+            }
+            catch (Exception e) { LogFormater.Warn("[Companion] puppet look: " + e.Message); }
+        }
+
+        /// <summary>The way a rotation faces on the ground, in radians (0 = east, counter-clockwise).</summary>
+        static double Yaw(Quaternion q)
+        {
+            var f = Vector3.UnitX * q;
+            return Math.Atan2(f.Y, f.X);
+        }
+
+        /// <summary>The bot's real facing as the region last reported it (its avatar object), else the agent's own value.</summary>
+        static double RealYaw(GridClient c)
+        {
+            var sim = c.Network.CurrentSim;
+            if (sim != null && c.Self.SittingOn == 0 && sim.ObjectsAvatars.TryGetValue(c.Self.LocalID, out var me)) return Yaw(me.Rotation);
+            return Yaw(c.Self.SimRotation);
+        }
+
+        /// <summary>Still standing where the last hand movement left it (nothing else moved or turned it since)?</summary>
+        static bool StillThere(GridClient c) =>
+            DateTime.Now - lastMove < TimeSpan.FromMinutes(10) && (!settled || Vector3.Distance(c.Self.SimPosition, endPos) < 1.5f);
+        static readonly string[] Holds = ["forward", "back", "left", "right", "turnleft", "turnright", "up", "down"];
+
+        [About("Moves the bot like a viewer's move controls. forward back left right turnleft turnright up down hold for 'ms'; stop, run, walk, fly, land, stand act at once")]
+        [ReturnHints("ok")]
+        [ArgHints("action", "forward, back, left, right, turnleft, turnright, up, down, stop, run, walk, fly, land or stand", "Text", "forward")]
+        [ArgHints("ms", "how long to hold it (100-3000 ms; repeat to keep going)", "Number", "500")]
+        [CmdTypeDo()]
+        public object CompanionMove(string action, string ms)
+        {
+            var c = GetClient();
+            if (c?.Network?.CurrentSim == null) return Failure("not online");
+            string a = (action ?? "").Trim().ToLowerInvariant();
+            int.TryParse(ms, out int t);
+            t = Math.Clamp(t <= 0 ? 500 : t, 100, 3000);
+            switch (a)
+            {
+                case "stop":
+                    lock (gate) held.Clear();
+                    Apply(c, true);
+                    return BasicReply("stopped");
+                case "run": c.Self.Movement.AlwaysRun = true; c.Self.Movement.SendUpdate(true); return BasicReply("running");
+                case "walk": c.Self.Movement.AlwaysRun = false; c.Self.Movement.SendUpdate(true); return BasicReply("walking");
+                case "fly": c.Self.Fly(true); return BasicReply("flying");
+                case "land": c.Self.Fly(false); return BasicReply("landing");
+                case "stand": c.Self.Stand(); return BasicReply("standing up");
+            }
+            if (!Holds.Contains(a)) return Failure("unknown action", [action]);
+            if (c.Self.SittingOn != 0) return Failure("the bot sits – press Stand first");
+            if (!string.IsNullOrEmpty(CompanionPeople.FollowInfo)) CompanionPeople.StopFollow(c, "moved by hand");
+            lock (gate)
+            {
+                // a new start keeps the facing the bot was given by hand; only when something else moved it
+                // (following, a seat, a teleport) the real facing is read again - else it would snap back
+                if (!moving && !StillThere(c)) heading = RealYaw(c);
+                held[a] = DateTime.Now.AddMilliseconds(t);
+                lastMove = DateTime.Now;
+                client = c;
+                tick ??= new Timer(_ => Tick(), null, Timeout.Infinite, Timeout.Infinite);
+                if (!moving) { moving = true; c.Self.AutoPilotCancel(); tick.Change(0, 100); }
+            }
+            return BasicReply("ok");
+        }
+
+        static void Tick()
+        {
+            var c = client;
+            if (c == null) return;
+            try
+            {
+                bool any;
+                lock (gate)
+                {
+                    foreach (var k in held.Where(kv => kv.Value < DateTime.Now).Select(kv => kv.Key).ToList()) held.Remove(k);
+                    any = held.Count > 0;
+                    if (held.ContainsKey("turnleft")) heading += 6 * Math.PI / 180;      // 60° a second
+                    if (held.ContainsKey("turnright")) heading -= 6 * Math.PI / 180;
+                }
+                Apply(c, !any);
+                if (!any) lock (gate) { moving = false; endPos = c.Self.SimPosition; settled = false; tick?.Change(Timeout.Infinite, Timeout.Infinite); }
+            }
+            catch (Exception e) { LogFormater.Warn("[Companion] puppet: " + e.Message); }
+        }
+
+        static void Apply(GridClient c, bool release)
+        {
+            var m = c.Self.Movement;
+            bool Has(string k) { lock (gate) return held.ContainsKey(k); }
+            m.AtPos = !release && Has("forward");
+            m.AtNeg = !release && Has("back");
+            m.LeftPos = !release && Has("left");
+            m.LeftNeg = !release && Has("right");
+            m.UpPos = !release && Has("up");
+            m.UpNeg = !release && Has("down");
+            var rot = Quaternion.CreateFromAxisAngle(Vector3.UnitZ, (float)heading);
+            m.BodyRotation = rot;
+            m.HeadRotation = rot;
+            m.Camera.Position = c.Self.SimPosition;
+            m.Camera.LookDirection(new Vector3((float)Math.Cos(heading), (float)Math.Sin(heading), 0));
+            m.SendUpdate(true);
+            Trace(release ? "rel" : "sent", heading, c.Self.SimPosition, c.Self.Velocity);
+            lock (gate) Look(c, release);
+        }
+
+        /// <summary>A place from a SLURL (maps.secondlife.com/secondlife/Region/x/y/z, secondlife://Region/x/y/z,
+        /// secondlife:///app/teleport/...), "Region/x/y/z", or just "x y z" / "x,y,z" in the bot's region.</summary>
+        public static (string region, Vector3 pos)? ParsePlace(string text, string currentRegion)
+        {
+            string t = Uri.UnescapeDataString((text ?? "").Trim());
+            var inv = System.Globalization.CultureInfo.InvariantCulture;
+            var nums = t.Split([',', ' ', ';'], StringSplitOptions.RemoveEmptyEntries);
+            if (nums.Length >= 2 && nums.Length <= 3 && nums.All(n => float.TryParse(n, System.Globalization.NumberStyles.Float, inv, out _)))
+            {
+                float z = nums.Length == 3 ? float.Parse(nums[2], inv) : 0;
