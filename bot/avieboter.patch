+                (c.Inventory.Store.Contains(id) ? c.Inventory.Store[id].Name : null) ?? links.FirstOrDefault(l => l.AssetUUID == id)?.Name ?? "(name not loaded yet)";
+            var att = WornAttachments().Select(kv => new { id = kv.Key.ToString(), name = NameOf(kv.Key), point = kv.Value.ToString() })
+                .OrderBy(x => x.point).ToList();
+            var wear = WornWearables().Select(id =>
+            {
+                var l = links.FirstOrDefault(x => x.AssetUUID == id);
+                var w = c.Appearance.GetWearables().FirstOrDefault(x => x.ItemID == id);
