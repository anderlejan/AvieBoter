+        /// <summary>Puts the current HUD scripts (core + menu) and a fresh courier script into the worn courier.</summary>
+        (bool, string) LoadCourier(Primitive courier)
+        {
+            var c = GetClient();
+            string core = ReadFileFromEnv("SLBM_HUD_SCRIPT"), menu = ReadFileFromEnv("SLBM_HUD_MENU");
+            if (core == null || menu == null) return (false, "the HUD scripts were not found");
+            var inv = c.Inventory.GetTaskInventory(courier.ID, courier.LocalID, TimeSpan.FromSeconds(15)) ?? [];
+            foreach (var old in inv.OfType<InventoryItem>().Where(i => i.AssetType == AssetType.LSLText))
+                c.Inventory.RemoveTaskInventory(courier.LocalID, old.UUID, c.Network.CurrentSim);
+            if (inv.Count > 0) Thread.Sleep(1000);
+            var r1 = PutScript(courier.LocalID, HudMainScript, core, false);
+            if (!r1.ok) return (false, "HUD script did not compile: " + r1.step + " " + string.Join(" ", r1.messages));
+            var r2 = PutScript(courier.LocalID, HudMenuScript, menu, false);
+            if (!r2.ok) return (false, "HUD menu script did not compile: " + r2.step + " " + string.Join(" ", r2.messages));
