+                {
+                    if (p.NameValues == null) continue;
+                    foreach (var nv in p.NameValues)
+                        if (nv.Name == "AttachItemID" && UUID.TryParse(nv.Value?.ToString() ?? "", out UUID id)) d[id] = p.PrimData.AttachmentPoint;
+                }
