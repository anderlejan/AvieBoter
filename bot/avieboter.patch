+                    .Select(f => new { id = f.UUID.ToString(), name = f.Name, type = f.PreferredType.ToString() }),
+                items = list.OfType<InventoryItem>().OrderBy(i => i.Name, StringComparer.OrdinalIgnoreCase).Select(i => ItemJson(i, att, wear))
