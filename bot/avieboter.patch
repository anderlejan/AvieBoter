+        // ---------- walking ----------
+        /// <summary>Walks (or flies, for height differences) to a point in the bot's region with the server's
+        /// autopilot. Returns true when the bot got within 'near' metres.</summary>
+        public static bool WalkTo(GridClient c, Vector3 target, float near, int timeoutSec)
+        {
+            var sim = c.Network.CurrentSim;
+            if (sim == null) return false;
+            if (c.Self.SittingOn != 0) { c.Self.Stand(); Thread.Sleep(800); }
+            bool fly = Math.Abs(target.Z - c.Self.SimPosition.Z) > 2.5f;
+            if (fly) c.Self.Fly(true);
+            var g = CompanionRadarData.Global(sim.Handle, target);
+            c.Self.AutoPilot(g.X, g.Y, target.Z);
+            LogFormater.Info("[Companion] walking" + (fly ? " (flying)" : "") + " to " + target + ", " + Math.Round(Vector3.Distance(c.Self.SimPosition, target), 1) + " m");
+            DateTime until = DateTime.Now.AddSeconds(timeoutSec), lastProgress = DateTime.Now;
+            float best = float.MaxValue;
+            bool ok = false;
+            while (DateTime.Now < until)
+            {
+                Thread.Sleep(500);
+                if (c.Network.CurrentSim != sim) break;
+                float d = Vector3.Distance(c.Self.SimPosition, target);
+                if (d <= near) { ok = true; break; }
+                if (d < best - 0.3f) { best = d; lastProgress = DateTime.Now; }
+                else if (DateTime.Now - lastProgress > TimeSpan.FromSeconds(6)) { LogFormater.Info("[Companion] walking: no progress at " + Math.Round(d, 1) + " m (blocked?)"); break; }
+            }
+            c.Self.AutoPilotCancel();
+            if (fly && ok) c.Self.Fly(false);
+            return ok;
+        }
