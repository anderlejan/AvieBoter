+
+        [About("Searches the bot's whole inventory (not the Trash) for items and folders whose name contains the text")]
+        [ReturnHints("json [{id, name, folder, folderName, isFolder, ...}] (at most 300)")]
+        [ArgHints("text", "part of the name", "Text")]
+        [CmdTypeGet()]
+        public object CompanionInvSearch(string text)
+        {
+            var c = GetClient();
+            string q = (text ?? "").Trim();
+            if (q.Length < 2) return Failure("type at least two letters", [text]);
+            var att = WornAttachments(); var wear = WornWearables();
+            var hits = new List<object>();
+            var todo = new Queue<(UUID id, string name)>();
+            todo.Enqueue((c.Inventory.Store.RootFolder.UUID, "Inventory"));
+            UUID trash = Trash;
+            DateTime until = DateTime.Now.AddSeconds(45);
+            while (todo.Count > 0 && DateTime.Now < until && hits.Count < 300)
+            {
+                var (f, fname) = todo.Dequeue();
+                foreach (var b in c.Inventory.FolderContents(f, c.Self.AgentID, true, true, InventorySortOrder.ByName, TimeSpan.FromSeconds(15)) ?? [])
+                {
+                    bool match = b.Name.Contains(q, StringComparison.OrdinalIgnoreCase);
+                    if (b is InventoryFolder sub)
+                    {
+                        if (sub.UUID == trash) continue;
