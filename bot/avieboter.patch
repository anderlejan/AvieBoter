+                members = all.Select(m => new
+                {
+                    id = m.ID.ToString(), name = CompanionNames.Get(null, m.ID), title = m.Title, online = m.OnlineStatus, owner = m.IsOwner,
+                    roles = byMember.TryGetValue(m.ID, out var l) ? l : new List<string>()
+                })
+            }));
+        }
+
+        [About("Group actions: activate, none (no active group), title, notices on/off, profile on/off, invite, eject, addrole, removerole, join, leave")]
+        [ReturnHints("result text")]
+        [ArgHints("group", "group key", "UUID")]
+        [ArgHints("action", "what to do", "Text", "activate")]
+        [ArgHints("avatar", "avatar key or name (invite, eject, roles), or on/off", "Text", "none")]
+        [ArgHints("role", "role key (title, invite, roles) or none", "Text", "none")]
+        [CmdTypeDo()]
+        public object CompanionGroupDo(string group, string action, string avatar, string role)
+        {
+            var c = GetClient();
+            UUID.TryParse(group ?? "", out UUID g);
+            UUID.TryParse(role ?? "", out UUID r);
+            string a = (action ?? "").Trim().ToLowerInvariant();
+            if (a == "none") { c.Groups.ActivateGroup(UUID.Zero); return BasicReply("no active group"); }
+            if (g == UUID.Zero) return Failure("bad group key", [group]);
+            if (a == "join")
+            {
+                var e = Ask<GroupOperationEventArgs>(h => c.Groups.GroupJoinedReply += h, h => c.Groups.GroupJoinedReply -= h,
+                    () => c.Groups.RequestJoinGroup(g), x => x.GroupID == g);
+                if (e == null) return Failure("no answer – is the group open to join?", [group]);
+                return e.Success ? BasicReply("joined") : Failure("could not join (closed group, fee, or too many groups?)", [group]);
+            }
+            var groups = CurrentGroups(c);
+            if (!groups.TryGetValue(g, out Group gr)) return Failure("the bot is not in this group", [group]);
+            UUID who = UUID.Zero;
+            if (a is "invite" or "eject" or "addrole" or "removerole")
+            {
+                if (!UUID.TryParse(avatar ?? "", out who)) who = CompanionNames.Find(c, avatar ?? "", 10000);
+                if (who == UUID.Zero) return Failure("avatar not found", [avatar]);
+            }
+            switch (a)
+            {
+                case "activate": c.Groups.ActivateGroup(g); return BasicReply("active group: " + gr.Name);
+                case "title": c.Groups.ActivateTitle(g, r); return BasicReply("title changed");
+                case "notices": c.Groups.SetGroupAcceptNotices(g, avatar == "on", gr.ListInProfile); return BasicReply("notices " + (avatar == "on" ? "on" : "off"));
+                case "profile": c.Groups.SetGroupAcceptNotices(g, gr.AcceptNotices, avatar == "on"); return BasicReply("in profile " + (avatar == "on" ? "on" : "off"));
+                case "invite":
+                    if (!Has(gr.Powers, GroupPowers.Invite)) return Failure("the bot may not invite in this group");
+                    c.Groups.Invite(g, r == UUID.Zero ? new List<UUID> { UUID.Zero } : new List<UUID> { UUID.Zero, r }, who);
+                    LogFormater.Info("[Companion] invited " + who + " to the group " + gr.Name);
+                    return BasicReply("invitation sent");
+                case "eject":
+                    if (!Has(gr.Powers, GroupPowers.Eject)) return Failure("the bot may not eject in this group");
+                    var ej = Ask<GroupOperationEventArgs>(h => c.Groups.GroupMemberEjected += h, h => c.Groups.GroupMemberEjected -= h,
+                        () => c.Groups.EjectUser(g, who), x => x.GroupID == g);
+                    if (ej != null && !ej.Success) return Failure("the grid refused the eject (owners cannot be ejected)");
+                    return BasicReply("ejected");
+                case "addrole":
+                    if (r == UUID.Zero) return Failure("choose a role");
+                    c.Groups.AddToRole(g, r, who); return BasicReply("role given");
+                case "removerole":
+                    if (r == UUID.Zero) return Failure("choose a role");
+                    c.Groups.RemoveFromRole(g, r, who); return BasicReply("role taken away");
+                case "leave":
+                    var lv = Ask<GroupOperationEventArgs>(h => c.Groups.GroupLeaveReply += h, h => c.Groups.GroupLeaveReply -= h,
+                        () => c.Groups.LeaveGroup(g), x => x.GroupID == g);
+                    if (lv != null && !lv.Success) return Failure("could not leave (the last owner cannot leave)");
+                    return BasicReply("left " + gr.Name);
+            }
+            return Failure("unknown action", [action]);
+        }
+
+        [About("Sends a notice to one of the bot's groups")]
+        [ReturnHints("sent")]
+        [ArgHints("group", "group key", "UUID")]
+        [ArgHints("subject", "the notice's subject", "Text")]
+        [ArgHints("message", "the notice's text", "Text")]
+        [CmdTypeDo()]
+        public object CompanionGroupNotice(string group, string subject, string message)
+        {
+            if (!UUID.TryParse(group, out UUID g)) return Failure("bad group key", [group]);
+            if (string.IsNullOrWhiteSpace(subject) || string.IsNullOrWhiteSpace(message)) return Failure("subject and text needed");
+            var c = GetClient();
+            c.Groups.SendGroupNotice(g, new GroupNotice { Subject = subject, Message = message, OwnerID = c.Self.AgentID, AttachmentID = UUID.Zero });
+            return BasicReply("sent");
+        }
+
+        [About("Group invitations the bot received and has not answered yet")]
+        [ReturnHints("json [{group, session, from, message, t}]")]
+        [CmdTypeGet()]
+        public object CompanionGroupInvites()
+        {
+            return BasicReply(J(CompanionGroupInvitations.List().Select(i => new { group = i.Group.ToString(), session = i.Session.ToString(), from = i.From, message = i.Message, t = i.At })));
+        }
+
+        [About("Accepts or declines a group invitation the bot received")]
+        [ReturnHints("accepted or declined")]
+        [ArgHints("group", "group key from CompanionGroupInvites", "UUID")]
+        [ArgHints("answer", "accept or decline", "Text", "accept")]
+        [CmdTypeDo()]
+        public object CompanionGroupInviteAnswer(string group, string answer)
+        {
+            if (!UUID.TryParse(group, out UUID g)) return Failure("bad group key", [group]);
+            var inv = CompanionGroupInvitations.Take(g);
+            if (inv == null) return Failure("no open invitation for this group", [group]);
+            bool yes = (answer ?? "").Trim().ToLowerInvariant() == "accept";
+            GetClient().Self.GroupInviteRespond(g, inv.Session, yes);
+            LogFormater.Info("[Companion] group invitation " + (yes ? "accepted" : "declined") + ": " + inv.Message);
+            return BasicReply(yes ? "accepted" : "declined");
+        }
