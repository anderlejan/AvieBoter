+// AvieBoter patch: commands for a companion / passenger bot driven by an in-world HUD.
+// Long actions run in the background and report to a reply target (the HUD's HTTP-in URL),
+// so the IM handler that received the command is never blocked.
+using OpenMetaverse;
+using SecondBotEvents.Services;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SecondBotEvents.Commands
+{
+    [ClassInfo("Companion / passenger commands used by the AvieBoter HUD and app")]
+    public class Companion(EventsSecondBot setmaster) : CommandsAPI(setmaster)
+    {
+        static int busy = 0;
+
+        object StatusObject(string note = "")
+        {
+            var c = GetClient();
+            bool online = c != null && c.Network != null && c.Network.Connected && c.Network.CurrentSim != null;
+            if (!online)
+            {
+                return new { online = false, note };
+            }
+            Vector3 p = c.Self.SimPosition;
+            string seatId = "";
+            string seatName = "";
+            uint seat = c.Self.SittingOn;
+            if (seat != 0 && c.Network.CurrentSim.ObjectsPrimitives.TryGetValue(seat, out Primitive prim))
+            {
+                seatId = prim.ID.ToString();
+                seatName = prim.Properties?.Name ?? "";
+            }
+            ulong h = c.Network.CurrentSim.Handle;
+            Utils.LongToUInts(h, out uint gx, out uint gy);
+            return new
+            {
+                online = true,
+                name = c.Self.Name,
+                uuid = c.Self.AgentID.ToString(),
+                region = c.Network.CurrentSim.Name,
+                cornerX = gx,
+                cornerY = gy,
+                x = Math.Round(p.X, 1),
+                y = Math.Round(p.Y, 1),
+                z = Math.Round(p.Z, 1),
+                sitting = seat != 0,
+                flying = seat == 0 && c.Self.Movement.Fly,
+                seatId,
+                seatName,
+                busy = busy == 1,
+                objectsSeen = c.Network.CurrentSim.ObjectsPrimitives.Count,
+                hudVersion = CompanionBuild.LastHudVersion,
+                hudSeen = CompanionBuild.LastHudSeen,
+                hudLatest = CompanionBuild.LatestHudVersion(),
+                hudJob = CompanionBuild.HudJob,
+                following = CompanionPeople.FollowInfo,
+                note
+            };
+        }
+
+        [About("Returns the bot's state for the app and the HUD: online, name, uuid, region, position, seat")]
+        [ReturnHints("json object")]
+        [CmdTypeGet()]
+        public object CompanionStatus()
+        {
+            return BasicReply(System.Text.Json.JsonSerializer.Serialize(StatusObject()));
+        }
+
+        [About("Sits on an object and waits for the server to confirm (sends the AgentSit follow-up)")]
+        [ReturnHints("seated")]
+        [ReturnHintsFailure("Invaild object uuid")]
+        [ReturnHintsFailure("No sit response")]
+        [ArgHints("target", "the object to sit on", "UUID")]
+        [CmdTypeDo()]
+        public object SitOn(string target)
+        {
+            if (UUID.TryParse(target, out UUID obj) == false || obj == UUID.Zero)
+            {
+                return Failure("Invaild object uuid", [target]);
+            }
+            string r = DoSit(obj);
+            return r == "seated" ? BasicReply(r, [target]) : Failure(r, [target]);
+        }
+
+        [About("Teleports next to a place (global region corner + local position) in the background")]
+        [ReturnHints("started")]
+        [ArgHints("cornerX", "region corner X in metres (llGetRegionCorner)", "Number")]
+        [ArgHints("cornerY", "region corner Y in metres (llGetRegionCorner)", "Number")]
+        [ArgHints("x", "local X", "Float")]
+        [ArgHints("y", "local Y", "Float")]
+        [ArgHints("z", "local Z", "Float")]
+        [ArgHints("replyto", "Where to send the result", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionCome(string cornerX, string cornerY, string x, string y, string z, string replyto)
+        {
+            return CompanionJoin(cornerX, cornerY, x, y, z, "none", replyto);
+        }
+
+        [About("Comes to a place and, if target is an object, sits on it (passenger mode). Runs in the background")]
+        [ReturnHints("started")]
+        [ReturnHintsFailure("busy")]
+        [ArgHints("cornerX", "region corner X in metres (llGetRegionCorner)", "Number")]
+        [ArgHints("cornerY", "region corner Y in metres (llGetRegionCorner)", "Number")]
+        [ArgHints("x", "local X", "Float")]
+        [ArgHints("y", "local Y", "Float")]
+        [ArgHints("z", "local Z", "Float")]
+        [ArgHints("target", "object to sit on, or none", "UUID")]
+        [ArgHints("replyto", "Where to send the result", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionJoin(string cornerX, string cornerY, string x, string y, string z, string target, string replyto)
+        {
+            if (!uint.TryParse(cornerX, out uint cx) || !uint.TryParse(cornerY, out uint cy)
+                || !float.TryParse(x, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out float fx)
+                || !float.TryParse(y, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out float fy)
+                || !float.TryParse(z, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out float fz))
+            {
+                return Failure("bad position", [cornerX, cornerY, x, y, z, target]);
+            }
+            UUID seat = UUID.Zero;
+            if (target != "none" && target != "" && UUID.TryParse(target, out UUID t))
+            {
+                seat = t;
+            }
+            if (Interlocked.CompareExchange(ref busy, 1, 0) != 0)
+            {
+                return Failure("busy", [target]);
+            }
+            Task.Run(() =>
+            {
+                string result;
+                try
+                {
+                    result = JoinFor(Utils.UIntsToLong(cx, cy), new Vector3(fx, fy, fz), seat, CompanionAccess.LastCaller, replyto);
+                }
+                catch (Exception e)
+                {
+                    result = "error: " + e.Message;
+                }
+                finally
+                {
+                    busy = 0;
+                }
+                Reply(replyto, seat == UUID.Zero ? "CompanionCome" : "CompanionJoin", result);
+            });
+            return BasicReply("started", [target]);
+        }
+
+        internal void Reply(string replyto, string command, string result)
+        {
+            LogFormater.Info("[Companion] " + command + ": " + result);
+            if (string.IsNullOrEmpty(replyto) || replyto == "none")
+            {
+                return;
+            }
+            string json = System.Text.Json.JsonSerializer.Serialize(new { command, result, status = StatusObject() });
+            master.CommandsService.SmartCommandReply(replyto, json, command);
+        }
+
+        /// <summary>Gets the bot next to a place (and onto a seat). Ways, in this order:
+        /// close by in the same region: walk (teleports there may be rerouted to a landing point);
+        /// else teleport; if it lands far away (parcel landing point, telehub): walk the rest;
+        /// if that does not work either and someone asked (requester): send them a teleport request - an offered
+        /// teleport from them is accepted automatically and is not rerouted like a direct teleport.</summary>
+        public string JoinFor(ulong handle, Vector3 pos, UUID seat, UUID requester, string replyto)
+        {
+            var c = GetClient();
+            if (c?.Network?.CurrentSim == null)
+            {
+                return "not online";
+            }
+            CompanionPeople.StopFollow(c, "asked to come or sit");
+            if (c.Self.SittingOn != 0)
+            {
+                c.Self.Stand();
+                Thread.Sleep(800);
+            }
+            // Land 1.5 m to the side so the bot does not appear inside the owner.
+            Vector3 landing = new(Math.Clamp(pos.X + 1.5f, 1f, 255f), Math.Clamp(pos.Y, 1f, 255f), pos.Z);
+            bool sameSim = c.Network.CurrentSim.Handle == handle;
+            float dist = sameSim ? Vector3.Distance(c.Self.SimPosition, pos) : -1f;
+            LogFormater.Info("[Companion] join: target " + handle + " " + pos + ", bot in " + c.Network.CurrentSim.Name
+                + " at " + c.Self.SimPosition + (sameSim ? ", distance " + Math.Round(dist, 1) + " m" : ", other region"));
+            string how = "";
+            if (!sameSim || dist > 3f)
+            {
+                bool there = false;
+                if (sameSim && dist <= 40f && Math.Abs(pos.Z - c.Self.SimPosition.Z) < 20f)
+                {
+                    there = CompanionPeople.WalkTo(c, landing, 2.5f, 30);
+                    if (there) how = " (walked)";
+                }
+                string problem = "";
+                if (!there)
+                {
+                    LogFormater.Info("[Companion] teleporting to " + handle + " " + landing);
+                    string tpWhy = TeleportChecked(handle, landing);
+                    if (tpWhy != "") problem = "teleport failed: " + tpWhy;
+                    else
+                    {
+                        Thread.Sleep(1500);
+                        if (c.Network.CurrentSim?.Handle != handle) problem = "the teleport ended in " + c.Network.CurrentSim?.Name;
+                        else
+                        {
+                            float off = Vector3.Distance(c.Self.SimPosition, landing);
+                            if (off <= 4f) there = true;
+                            else
+                            {
+                                LogFormater.Info("[Companion] landed " + Math.Round(off) + " m away (landing point or telehub?) - walking the rest");
+                                there = off <= 150f && Math.Abs(landing.Z - c.Self.SimPosition.Z) < 60f
+                                    && CompanionPeople.WalkTo(c, landing, 3f, Math.Clamp((int)(off / 2.5f) + 15, 20, 90));
+                                if (there) how = " (the teleport landed " + Math.Round(off) + " m away; walked the rest)";
+                                else problem = "the teleport landed " + Math.Round(off) + " m away (a landing point?) and walking there did not work";
+                            }
+                        }
+                    }
+                }
+                if (!there)
+                {
+                    if (requester == UUID.Zero) return problem;
+                    LogFormater.Info("[Companion] asking " + requester + " for a teleport offer: " + problem);
+                    c.Self.SendTeleportLureRequest(requester, "I could not get to you by myself (" + problem + "). Please offer me a teleport - I accept it.");
+                    Reply(replyto, seat == UUID.Zero ? "CompanionCome" : "CompanionJoin",
+                        "could not get to you by itself (" + problem + "). It sent you a teleport request – click Offer Teleport in it.");
+                    DateTime until = DateTime.Now.AddSeconds(90);
+                    while (DateTime.Now < until)
+                    {
+                        Thread.Sleep(1000);
+                        if (c.Network.CurrentSim?.Handle == handle && Vector3.Distance(c.Self.SimPosition, pos) < 25f) { there = true; break; }
+                    }
+                    if (!there) return "could not get to you: " + problem + " – and no teleport offer came";
+                    how = " (with your teleport offer)";
+                    Thread.Sleep(1500);
+                }
+            }
+            if (seat == UUID.Zero)
+            {
+                return sameSim && dist <= 3f ? "already here" : "arrived" + how;
+            }
+            // Wait until the vehicle is known to the bot (object updates arrive after a teleport).
+            DateTime seen = DateTime.Now.AddSeconds(20);
+            while (DateTime.Now < seen && FindPrim(seat) == null)
+            {
+                Thread.Sleep(500);
+            }
+            if (FindPrim(seat) == null)
+            {
+                LogFormater.Warn("[Companion] vehicle not seen yet, trying to sit anyway");
+            }
+            return DoSit(seat);
+        }
+
+        /// <summary>Teleports and returns "" on success. A teleport can "time out" on the bot's side although the region
+        /// moved it (seen 2026-11-22): then check where the bot is; if it did not arrive, try once more.</summary>
+        string TeleportChecked(ulong handle, Vector3 landing)
+        {
+            var c = GetClient();
+            string why = "";
+            for (int attempt = 1; attempt <= 2; attempt++)
+            {
+                if (c.Self.Teleport(handle, landing)) return "";
+                why = string.IsNullOrEmpty(c.Self.TeleportMessage) ? "no answer" : c.Self.TeleportMessage;
+                LogFormater.Warn("[Companion] teleport attempt " + attempt + " reported: " + why);
+                DateTime until = DateTime.Now.AddSeconds(8);
+                while (DateTime.Now < until)
+                {
+                    if (c.Network.CurrentSim != null && c.Network.CurrentSim.Handle == handle
+                        && Vector3.Distance(c.Self.SimPosition, landing) < 12f)
+                    {
+                        LogFormater.Info("[Companion] the bot arrived anyway (" + c.Network.CurrentSim.Name + " " + c.Self.SimPosition + ")");
+                        return "";
+                    }
+                    Thread.Sleep(500);
+                }
+                if (attempt == 1) LogFormater.Info("[Companion] not there - trying the teleport once more");
+            }
+            return why + " (tried twice)";
+        }
+
+        Primitive FindPrim(UUID id)
+        {
+            var sim = GetClient()?.Network?.CurrentSim;
+            if (sim == null) return null;
+            return sim.ObjectsPrimitives.Values.FirstOrDefault(p => p.ID == id);
+        }
+
+        static UUID lastSitObj = UUID.Zero;
+        static Vector3 lastSitOffset = Vector3.Zero, firstSitOffset = Vector3.Zero;
+
+        string DoSit(UUID obj, List<Vector3> explicitOffsets = null)
+        {
+            var c = GetClient();
+            CompanionPeople.StopFollow(c, "sitting down");
+            Primitive prim = FindPrim(obj);
+            string seen = "not seen by the bot";
+            if (prim != null)
+            {
+                Vector3 at = PrimRegionPosition(prim);
+                float d = Vector3.Distance(c.Self.SimPosition, at);
+                seen = "seen " + Math.Round(d, 1) + " m away";
+                if (d > 6f)
+                {
+                    // without a sit target SL only lets you sit close by: step next to it first
+                    LogFormater.Info("[Companion] sit: object " + seen + ", moving next to it");
+                    Vector3 near = at + new Vector3(1f, 0f, 0.5f);
+                    if (!(Vector3.Distance(c.Self.SimPosition, near) <= 40f && CompanionPeople.WalkTo(c, near, 2.5f, 30)))
+                    {
+                        c.Self.Teleport(c.Network.CurrentSim.Handle, near);
+                        Thread.Sleep(1500);
+                        if (Vector3.Distance(c.Self.SimPosition, near) > 6f) CompanionPeople.WalkTo(c, near, 2.5f, 40);
+                    }
+                    seen += ", moved closer";
+                }
+            }
+            LogFormater.Info("[Companion] sit on " + obj + ": " + seen);
+            // SL needs the point on the surface that was "clicked" (relative to the object) when there is no sit target:
+            // use the top of the object when its size is known, otherwise try a few heights.
+            List<Vector3> offsets = explicitOffsets ?? (prim != null
+                ? new List<Vector3> { new(0f, 0f, prim.Scale.Z * 0.5f), Vector3.Zero }
+                : new List<Vector3> { new(0f, 0f, 0.5f), new(0f, 0f, 1f), new(0f, 0f, 0.25f), new(0f, 0f, 2f) });
+            var alerts = new System.Collections.Concurrent.ConcurrentQueue<string>();
+            using ManualResetEventSlim got = new(false);
+            void handler(object s, AvatarSitResponseEventArgs e)
+            {
+                if (e.ObjectID == obj) got.Set();
+            }
+            void alert(object s, AlertMessageEventArgs e)
+            {
+                if (!string.IsNullOrEmpty(e.Message)) alerts.Enqueue(e.Message);
+            }
+            c.Self.AvatarSitResponse += handler;
+            c.Self.AlertMessage += alert;
+            try
+            {
+                foreach (Vector3 offset in offsets)
+                {
+                    got.Reset();
+                    while (alerts.TryDequeue(out string old)) { }
+                    LogFormater.Info("[Companion] sit request, surface offset " + offset);
+                    c.Self.RequestSit(obj, offset);
+                    if (got.Wait(TimeSpan.FromSeconds(5)))
+                    {
+                        c.Self.Sit();
+                        DateTime until = DateTime.Now.AddSeconds(6);
+                        while (DateTime.Now < until && c.Self.SittingOn == 0)
+                        {
+                            Thread.Sleep(250);
+                        }
+                        if (explicitOffsets == null || lastSitObj != obj) firstSitOffset = offset;
+                        lastSitObj = obj;
+                        lastSitOffset = offset;
+                        return c.Self.SittingOn != 0 ? "seated" : "sit confirmed by server, seat not reported yet (" + seen + ")";
+                    }
+                    // "no suitable surface" means: try another point; any other refusal is final
+                    if (!alerts.IsEmpty && !alerts.Any(a => a.Contains("suitable surface"))) break;
+                }
+                string why = alerts.IsEmpty ? "no answer from the region" : "region says: " + string.Join(" / ", alerts.Distinct());
+                return "could not sit (" + seen + "; " + why + ")";
+            }
+            finally
+            {
+                c.Self.AvatarSitResponse -= handler;
+                c.Self.AlertMessage -= alert;
+            }
+        }
+
+        Vector3 PrimRegionPosition(Primitive prim)
+        {
+            if (prim.ParentID == 0) return prim.Position;
+            var sim = GetClient().Network.CurrentSim;
+            if (sim.ObjectsPrimitives.TryGetValue(prim.ParentID, out Primitive parent))
+            {
+                return parent.Position + prim.Position * parent.Rotation;
+            }
+            return prim.Position;
+        }
+
+        [About("Sits on an object in the background and reports the result to the reply target (used by the HUD)")]
+        [ReturnHints("started")]
+        [ReturnHintsFailure("busy")]
+        [ArgHints("target", "the object to sit on", "UUID")]
+        [ArgHints("replyto", "Where to send the result", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionSit(string target, string replyto)
+        {
+            if (UUID.TryParse(target, out UUID obj) == false || obj == UUID.Zero)
+            {
+                return Failure("Invaild object uuid", [target]);
+            }
+            if (Interlocked.CompareExchange(ref busy, 1, 0) != 0)
+            {
+                return Failure("busy", [target]);
+            }
+            Task.Run(() =>
+            {
+                string result;
+                try { result = DoSit(obj); }
+                catch (Exception e) { result = "error: " + e.Message; }
+                finally { busy = 0; }
+                Reply(replyto, "CompanionSit", result);
+            });
+            return BasicReply("started", [target]);
+        }
+
+        [About("Sends an IM; the avatar can be a key, or a name looked up nearby, among friends or in SL's people search")]
+        [ReturnHints("json {uuid, name}")]
+        [ReturnHintsFailure("avatar not found")]
+        [ArgHints("avatar", "name (First Last / username) or key", "AVATAR")]
+        [ArgHints("message", "the message", "Text")]
+        [CmdTypeDo()]
+        public object CompanionIM(string avatar, string message)
+        {
+            if (string.IsNullOrWhiteSpace(message))
+            {
+                return Failure("Message empty", [avatar]);
+            }
+            var (id, name) = ResolveAvatar(avatar);
+            if (id == UUID.Zero)
+            {
+                return Failure("avatar not found: " + avatar, [avatar]);
+            }
+            GetClient().Self.InstantMessage(id, message);
+            LogFormater.Info("[Companion] IM sent to " + name + " (" + id + ")");
+            return BasicReply(System.Text.Json.JsonSerializer.Serialize(new { uuid = id.ToString(), name }), [avatar]);
+        }
+
+        static string NormName(string n) =>
+            System.Text.RegularExpressions.Regex.Replace((n ?? "").Trim().ToLowerInvariant().Replace('.', ' '), @"\s+", " ")
+                .Replace(" resident", "").Trim();
+
+        internal (UUID, string) ResolveAvatar(string avatar)
+        {
+            if (UUID.TryParse(avatar, out UUID direct) && direct != UUID.Zero) return (direct, avatar);
+            var c = GetClient();
+            string want = NormName(avatar);
+            foreach (var sim in c.Network.Simulators.ToArray())
+            {
+                foreach (var av in sim.ObjectsAvatars.Values)
+                {
+                    if (NormName(av.Name) == want) return (av.ID, av.Name);
+                }
+            }
+            foreach (var f in c.Friends.FriendList.Values)
+            {
+                if (NormName(f.Name) == want) return (f.UUID, f.Name);
+            }
+            // SL people search (legacy names: "first last"; one-word usernames are "username Resident")
+            UUID query = UUID.Random();
+            UUID found = UUID.Zero;
+            string foundName = "";
+            using ManualResetEventSlim done = new(false);
+            void reply(object s, AvatarPickerReplyEventArgs e)
+            {
+                if (e.QueryID != query) return;
+                foreach (var kv in e.Avatars)
+                {
+                    if (NormName(kv.Value) == want) { found = kv.Key; foundName = kv.Value; break; }
+                }
+                done.Set();
+            }
+            c.Avatars.AvatarPickerReply += reply;
+            try
+            {
+                c.Avatars.RequestAvatarNameSearch(avatar.Trim(), query);
+                done.Wait(TimeSpan.FromSeconds(8));
+            }
+            finally
+            {
+                c.Avatars.AvatarPickerReply -= reply;
+            }
+            return (found, foundName);
+        }
+
+        [About("Sets the bot's home location where it stands now and returns the region's answer")]
+        [ReturnHints("the region's answer")]
+        [CmdTypeDo()]
+        public object CompanionSetHome()
+        {
+            var c = GetClient();
+            var alerts = new System.Collections.Concurrent.ConcurrentQueue<string>();
+            void alert(object s, AlertMessageEventArgs e) { if (!string.IsNullOrEmpty(e.Message)) alerts.Enqueue(e.Message); }
+            c.Self.AlertMessage += alert;
+            try
+            {
+                c.Self.SetHome();
+                DateTime until = DateTime.Now.AddSeconds(6);
+                while (DateTime.Now < until && alerts.IsEmpty) Thread.Sleep(200);
+            }
+            finally { c.Self.AlertMessage -= alert; }
+            string answer = alerts.IsEmpty ? "no answer from the region" : string.Join(" / ", alerts.Distinct());
+            LogFormater.Info("[Companion] set home: " + answer);
+            bool ok = answer.IndexOf("home", StringComparison.OrdinalIgnoreCase) >= 0
+                && answer.IndexOf("set", StringComparison.OrdinalIgnoreCase) >= 0
+                && answer.IndexOf("can", StringComparison.OrdinalIgnoreCase) < 0;
+            return ok ? BasicReply(answer) : Failure(answer);
+        }
+
+        [About("Lists the folders in My Outfits (names to use with CompanionWear)")]
+        [ReturnHints("json [names]")]
+        [CmdTypeGet()]
+        public object CompanionOutfits()
+        {
+            var store = GetClient().Inventory.Store;
+            var root = store.GetNodeFor(store.RootFolder.UUID);
+            var outfits = root?.Nodes.Values.FirstOrDefault(n => string.Equals(n.Data.Name, "My Outfits", StringComparison.OrdinalIgnoreCase));
+            var names = outfits == null ? new List<string>() : outfits.Nodes.Values.Select(n => n.Data.Name).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();
+            return BasicReply(System.Text.Json.JsonSerializer.Serialize(names));
+        }
+
+        [About("Wears a folder by name, replacing the outfit: My Outfits/<name> first, else any folder with that name")]
+        [ReturnHints("worn <path>")]
+        [ReturnHintsFailure("folder not found")]
+        [ArgHints("name", "folder name (or a path like Clothes/Summer)", "Text")]
+        [ArgHints("replyto", "none = answer directly; else where to send the result (HUD)", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionWear(string name, string replyto)
+        {
+            if (string.IsNullOrWhiteSpace(name)) return Failure("no folder name", [name]);
+            if (string.IsNullOrEmpty(replyto) || replyto == "none")
+            {
+                string r = Wear(name.Trim());
+                return r.StartsWith("worn") ? BasicReply(r, [name]) : Failure(r, [name]);
+            }
+            Task.Run(() =>
+            {
+                string r;
+                try { r = Wear(name.Trim()); } catch (Exception e) { r = "error: " + e.Message; }
+                Reply(replyto, "CompanionWear", r);
+            });
+            return BasicReply("started", [name]);
+        }
+
+        static readonly HashSet<string> SkipFolders = new(StringComparer.OrdinalIgnoreCase) { "Trash", "Lost And Found", "Current Outfit", "Received Items", "Marketplace Listings" };
+
+        string Wear(string name)
+        {
+            var store = GetClient().Inventory.Store;
+            var root = store.GetNodeFor(store.RootFolder.UUID);
+            if (root == null) return "inventory not loaded yet";
+            InventoryNode found = null;
+            string foundPath = "";
+            // 1. My Outfits/<name> (or a path below My Outfits)
+            var outfits = root.Nodes.Values.FirstOrDefault(n => string.Equals(n.Data.Name, "My Outfits", StringComparison.OrdinalIgnoreCase));
+            if (outfits != null)
+            {
+                found = FindByPath(outfits, name);
+                if (found != null) foundPath = "My Outfits/" + name;
+            }
+            // 2. a path from the root, or any folder with that name (shallowest first)
+            if (found == null) { found = FindByPath(root, name); if (found != null) foundPath = name; }
+            if (found == null)
+            {
+                var queue = new Queue<(InventoryNode, string)>();
+                queue.Enqueue((root, ""));
+                while (queue.Count > 0 && found == null)
+                {
+                    var (node, path) = queue.Dequeue();
+                    foreach (var child in node.Nodes.Values.OrderBy(n => n.Data.Name))
+                    {
+                        if (SkipFolders.Contains(child.Data.Name)) continue;
+                        string p = path == "" ? child.Data.Name : path + "/" + child.Data.Name;
+                        if (string.Equals(child.Data.Name, name, StringComparison.OrdinalIgnoreCase)) { found = child; foundPath = p; break; }
+                        queue.Enqueue((child, p));
+                    }
+                }
+            }
+            if (found == null) return "folder not found: " + name;
+            LogFormater.Info("[Companion] wearing " + foundPath + " (" + found.Data.UUID + ")");
+            var res = new InventoryCommands(master).SwapOutfit(found.Data.UUID.ToString());
+            string json = System.Text.Json.JsonSerializer.Serialize(res);
+            bool ok = json.Contains("\"status\":true");
+            return ok ? "worn " + foundPath : "could not wear " + foundPath + ": " + json;
+        }
+
+        static InventoryNode FindByPath(InventoryNode start, string path)
+        {
+            InventoryNode node = start;
+            foreach (string part in path.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+            {
+                node = node.Nodes.Values.FirstOrDefault(n => string.Equals(n.Data.Name, part, StringComparison.OrdinalIgnoreCase));
+                if (node == null) return null;
+            }
+            return node == start ? null : node;
+        }
+
+        static double? hover = null;
+
+        [About("Makes the bot fly or land (on, off or toggle); stands up first when it sits")]
+        [ReturnHints("flying / not flying")]
+        [ArgHints("state", "on, off or toggle", "Text", "toggle")]
+        [ArgHints("replyto", "none or the HUD reply address", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionFly(string state, string replyto)
+        {
+            var c = GetClient();
+            bool on = (state ?? "").ToLowerInvariant() switch { "on" => true, "off" => false, _ => !c.Self.Movement.Fly };
+            if (on && c.Self.SittingOn != 0) { c.Self.Stand(); Thread.Sleep(800); }
+            c.Self.Fly(on);
+            string r = on ? "flying" : "not flying";
+            if (!string.IsNullOrEmpty(replyto) && replyto != "none") { Reply(replyto, "CompanionFly", r); return BasicReply("started"); }
+            return BasicReply(r, [state]);
+        }
+
+        static double? hoverDefault = null;    // set live by CompanionSetHover (the app's hover height setting)
+
+        static double DefaultHover() => hoverDefault ??
+            (double.TryParse(Environment.GetEnvironmentVariable("basic_DefaultHoverHeight"), System.Globalization.NumberStyles.Float,
+                System.Globalization.CultureInfo.InvariantCulture, out double h) ? h : 0.0);
+
+        [About("Sets the bot's hover height at once and makes it the height Adjust ▸ Reset goes back to")]
+        [ReturnHints("hover height")]
+        [ArgHints("height", "metres, -2 to 2", "Number", "0")]
+        [CmdTypeDo()]
+        public object CompanionSetHover(string height)
+        {
+            if (!double.TryParse(height, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double h))
+                return Failure("bad height", [height]);
+            h = Math.Clamp(h, -2.0, 2.0);
+            hoverDefault = h;
+            hover = h;
+            GetClient().Self.SetHoverHeight(h);
+            return BasicReply(h.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture), [height]);
+        }
+
+        [About("Adjusts the bot while it sits: up/down (hover height), forward/back/left/right (sits again a bit moved; only on seats without a fixed sit spot), reset")]
+        [ReturnHints("result text, sent to the reply target")]
+        [ArgHints("direction", "up, down, forward, back, left, right or reset", "Text", "up")]
+        [ArgHints("step", "step in metres", "Number", "0.05")]
+        [ArgHints("replyto", "none = answer directly; else where to send the result (HUD)", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionAdjust(string direction, string step, string replyto)
+        {
+            if (!float.TryParse(step, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out float st) || st <= 0f) st = 0.05f;
+            st = Math.Clamp(st, 0.01f, 0.5f);
+            string dir = (direction ?? "").Trim().ToLowerInvariant();
+            if (string.IsNullOrEmpty(replyto) || replyto == "none")
+            {
+                string r = Adjust(dir, st);
+                return r.StartsWith("could not") || r.StartsWith("not ") ? Failure(r, [direction, step]) : BasicReply(r, [direction, step]);
+            }
+            Task.Run(() =>
+            {
+                string r;
+                try { r = Adjust(dir, st); } catch (Exception e) { r = "error: " + e.Message; }
+                Reply(replyto, "CompanionAdjust", r);
+            });
+            return BasicReply("started", [direction, step]);
+        }
+
+        string Adjust(string dir, float st)
+        {
+            var c = GetClient();
+            if (dir == "up" || dir == "down" || dir == "reset")
+            {
+                double h = dir == "reset" ? DefaultHover() : Math.Clamp((hover ?? DefaultHover()) + (dir == "up" ? st : -st), -2.0, 2.0);
+                hover = Math.Round(h, 3);
+                c.Self.SetHoverHeight(hover.Value);
+                if (dir != "reset") return "height " + (hover.Value >= 0 ? "+" : "") + hover.Value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) + " m";
+            }
+            uint seatLocal = c.Self.SittingOn;
+            if (seatLocal == 0) return dir == "reset" ? "height reset" : "not seated - sit the bot first";
+            if (!c.Network.CurrentSim.ObjectsPrimitives.TryGetValue(seatLocal, out Primitive seat)) return "could not see the seat";
+            Vector3 delta = dir switch
+            {
+                "forward" => new Vector3(st, 0f, 0f),
+                "back" => new Vector3(-st, 0f, 0f),
+                "left" => new Vector3(0f, st, 0f),
+                "right" => new Vector3(0f, -st, 0f),
+                _ => Vector3.Zero
+            };
+            if (dir != "reset" && delta == Vector3.Zero) return "unknown direction " + dir;
+            Vector3 baseOffset = lastSitObj == seat.ID ? lastSitOffset : new Vector3(0f, 0f, seat.Scale.Z * 0.5f);
+            Vector3 offset = dir == "reset" ? (lastSitObj == seat.ID ? firstSitOffset : baseOffset) : baseOffset + delta;
+            Vector3 before = c.Self.RelativePosition;
+            c.Self.Stand();
+            Thread.Sleep(700);
+            string r = DoSit(seat.ID, [offset]);
+            if (!r.StartsWith("seated")) return "could not sit again: " + r;
+            Thread.Sleep(800);
+            if (dir != "reset" && Vector3.Distance(before, c.Self.RelativePosition) < st * 0.3f)
+                return "this seat has a fixed sit spot - only Up and Down can move the bot here";
+            return dir == "reset" ? "position and height reset" : "moved " + dir;
+        }
+
+        [About("Switches taking part in conference chats on or off (off = the bot leaves each conference at once)")]
+        [ReturnHints("on|off")]
+        [ArgHints("state", "on or off", "Text", "off")]
+        [CmdTypeSet()]
+        public object CompanionConferences(string state)
+        {
+            CompanionChat.LeaveConferences = string.Equals(state, "off", StringComparison.OrdinalIgnoreCase);
+            return BasicReply(CompanionChat.LeaveConferences ? "off" : "on");
+        }
+
+        [About("Returns chat and IMs the bot received after the given number (for the app)")]
+        [ReturnHints("json {seq, items}")]
+        [ArgHints("after", "last number already read (0 = all kept)", "Number")]
+        [CmdTypeGet()]
+        public object CompanionChatSince(string after)
+        {
+            long.TryParse(after, out long a);
+            return BasicReply(CompanionChat.Since(a));
+        }
+    }
+}
