+        }
+
+        /// <summary>Worn clothing and body parts: the links in the current outfit folder (as viewers keep it), plus what
+        /// the appearance code knows.</summary>
+        HashSet<UUID> WornWearables() => new(GetClient().Appearance.GetWearables().Select(w => w.ItemID).Concat(OutfitLinks().Where(l => l.InventoryType == InventoryType.Wearable).Select(l => l.AssetUUID)));
+
+        List<InventoryItem> OutfitLinks()
