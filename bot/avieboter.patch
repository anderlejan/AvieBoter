+        /// <summary>Downloads a texture and turns it into a PNG (largest side at most 1024 px).</summary>
+        static byte[] Png(GridClient c, UUID texture, out string why)
+        {
+            why = "could not get the picture";
+            OpenMetaverse.Assets.AssetTexture tex = null;
+            using var done = new ManualResetEventSlim();
+            c.Assets.RequestImage(texture, ImageType.Normal, (state, asset) =>
+            {
+                if (state == TextureRequestState.Finished) tex = asset;
+                if (state != TextureRequestState.Progress && state != TextureRequestState.Pending && state != TextureRequestState.Started) done.Set();
+            });
+            done.Wait(45000);
+            if (tex == null) return null;
+            try
+            {
+                if (!tex.Decode()) { why = "the picture could not be decoded"; return null; }
+                using var bmp = Bitmap(tex.Image);
+                SkiaSharp.SKBitmap use = bmp;
+                int max = Math.Max(bmp.Width, bmp.Height);
+                if (max > 1024)
+                {
+                    float k = 1024f / max;
+                    use = bmp.Resize(new SkiaSharp.SKImageInfo(Math.Max(1, (int)(bmp.Width * k)), Math.Max(1, (int)(bmp.Height * k))), new SkiaSharp.SKSamplingOptions(SkiaSharp.SKFilterMode.Linear, SkiaSharp.SKMipmapMode.Linear));
+                }
+                using var img = SkiaSharp.SKImage.FromBitmap(use);
+                using var enc = img.Encode(SkiaSharp.SKEncodedImageFormat.Png, 100);
+                var bytes = enc.ToArray();
+                if (!ReferenceEquals(use, bmp)) use.Dispose();
+                return bytes;
+            }
+            catch (Exception e) { why = "the picture could not be decoded: " + e.Message; return null; }
+        }
