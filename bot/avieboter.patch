+                    var it = c.Inventory.Store.Contains(iid) ? c.Inventory.Store[iid] as InventoryItem : c.Inventory.FetchItem(iid, c.Self.AgentID, TimeSpan.FromSeconds(10));
+                    if (it == null) return Failure("that item is not in the bot's inventory", [action]);
+                    if (it.AssetType == AssetType.LSLText) c.Inventory.CopyScriptToTask(p.LocalID, it, true); else c.Inventory.UpdateTaskInventory(p.LocalID, it);
+                    return BasicReply(it.Name + " goes into " + (p.Properties?.Name ?? "the object"), [action]);
+                }
+                var items = c.Inventory.GetTaskInventory(p.ID, p.LocalID, TimeSpan.FromSeconds(15)) ?? [];
+                var ti = items.OfType<InventoryItem>().FirstOrDefault(i => i.UUID == iid);
+                if (ti == null) return Failure("that item is not inside any more – look again", [action]);
+                switch (a)
+                {
+                    case "read":
+                        {
+                            if (ti.AssetType is not (AssetType.Notecard or AssetType.LSLText)) return Failure("only notecards and scripts can be read", [action]);
+                            string got = null;
+                            using var done = new ManualResetEventSlim();
+                            c.Assets.RequestInventoryAsset(ti.AssetUUID, ti.UUID, p.ID, ti.OwnerID, ti.AssetType, true, UUID.Random(), (t, asset) =>
+                            {
+                                if (t.Success && asset is AssetNotecard n) { n.Decode(); got = n.BodyText; }
+                                else if (t.Success && asset is AssetScriptText st) { st.Decode(); got = st.Source; }
+                                done.Set();
+                            });
+                            done.Wait(20000);
+                            return got == null ? Failure("could not read it (no permission?)", [action]) : BasicReply(got, [action]);
+                        }
+                    case "save":
+                        {
+                            if (ti.AssetType is not (AssetType.Notecard or AssetType.LSLText)) return Failure("only notecards and scripts have a text", [action]);
+                            if ((ti.Permissions.OwnerMask & PermissionMask.Modify) == 0) return Failure("the bot may not change " + ti.Name, [action]);
+                            string why = "the save did not answer";
+                            var msgs = new List<string>();
+                            using var done = new ManualResetEventSlim();
+                            if (ti.AssetType == AssetType.LSLText)
+                                c.Inventory.RequestUpdateScriptTask(System.Text.Encoding.UTF8.GetBytes(text), ti.UUID, p.ID, true, true,
+                                    (up, st, comp, cm, id, asset) => { why = up ? "" : "not saved: " + st; if (cm != null) msgs.AddRange(cm); if (up && !comp && msgs.Count == 0) msgs.Add("did not compile"); done.Set(); });
+                            else
+                            {
+                                var nc = new AssetNotecard { BodyText = text };
+                                nc.Encode();
+                                c.Inventory.RequestUpdateNotecardTask(nc.AssetData, ti.UUID, p.ID, (ok, st, id, asset) => { why = ok ? "" : "not saved: " + st; done.Set(); });
+                            }
+                            done.Wait(30000);
+                            if (why != "") return Failure(why, [action]);
+                            bool? running = null;
+                            if (ti.AssetType == AssetType.LSLText && !msgs.Any(m => m.Contains("ERROR", StringComparison.OrdinalIgnoreCase)))
+                            {
+                                c.Inventory.RequestSetScriptRunning(p.ID, ti.UUID, true);
+                                running = ScriptRunning(c, p.ID, ti.UUID);
+                            }
+                            return BasicReply(J(new { saved = true, messages = msgs, running }), [action]);
+                        }
+                    case "delete":
+                        c.Inventory.RemoveTaskInventory(p.LocalID, ti.UUID, sim);
+                        return BasicReply(ti.Name + " was deleted from inside", [action]);
+                    case "take":
+                        c.Inventory.MoveTaskInventory(p.LocalID, ti.UUID, c.Inventory.FindFolderForType(ti.AssetType), sim);
+                        return BasicReply(ti.Name + " goes into the bot's inventory" + ((ti.Permissions.OwnerMask & PermissionMask.Copy) == 0 ? " (no copy: it leaves the object)" : ""), [action]);
+                }
+                return Failure("unknown action", [action]);
+            }
+            catch (Exception e) { return Failure(e.Message, [action, localId]); }
+        }
+
+        [About("The menus, text boxes, permission questions and links objects sent the bot that are not answered yet")]
+        [ReturnHints("json [{id, t, kind (menu|text|permission|url), object, owner, message, buttons, perms, url, debit}]")]
+        [CmdTypeGet()]
+        public object CompanionMenus()
+        {
+            return BasicReply(CompanionMenuStore.List());
+        }
+
+        [About("Whether object menus are also shown on the HUD of the person who uses the bot (on / off / \"\" = ask)")]
+        [ReturnHints("on or off")]
+        [ArgHints("state", "on, off or nothing to ask", "Text", "")]
+        [CmdTypeDo()]
+        public object CompanionMenusToHud(string state)
+        {
+            string a = (state ?? "").Trim().ToLowerInvariant();
+            if (a == "on" || a == "off") CompanionMenuStore.SetToHud(a == "on");
+            return BasicReply(CompanionMenuStore.ToHudOn ? "on" : "off", [state]);
