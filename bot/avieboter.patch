+
+        static string ReadFileFromEnv(string var)
+        {
+            string p = Environment.GetEnvironmentVariable(var);
+            if (string.IsNullOrEmpty(p))
+            {
+                // started without the app's settings: the app keeps the HUD scripts in ..\wwwroot\hud next to the bot folder
+                string f = var == "SLBM_HUD_UPDATER" ? "AvieBoterHUDUpdater.lsl" : var == "SLBM_HUD_MENU" ? "AvieBoterHUDMenu.lsl" : "AvieBoterHUD.lsl";
+                p = System.IO.Path.Combine(AppContext.BaseDirectory, "..", "wwwroot", "hud", f);
+            }
+            try { return string.IsNullOrEmpty(p) || !System.IO.File.Exists(p) ? null : System.IO.File.ReadAllText(p); } catch { return null; }
+        }
+
+        public static string VersionOf(string script) =>
+            System.Text.RegularExpressions.Regex.Match(script ?? "", "string\\s+VERSION\\s*=\\s*\"([^\"]+)\"").Groups[1].Value;
+
+        public static string LatestHudVersion() => VersionOf(ReadFileFromEnv("SLBM_HUD_SCRIPT"));
+
+        static bool Older(string have, string latest)
+        {
+            if (string.IsNullOrEmpty(latest)) return false;
+            if (string.IsNullOrEmpty(have)) return true;
+            if (Version.TryParse(have, out var a) && Version.TryParse(latest, out var b)) return a < b;
+            return have != latest;
+        }
+
+        Primitive WornByItem(UUID itemId)
+        {
+            var c = GetClient();
+            uint me = c.Self.LocalID;
+            return c.Network.CurrentSim.ObjectsPrimitives.Values.FirstOrDefault(p => p.ParentID == me && p.NameValues != null
+                && p.NameValues.Any(nv => nv.Name == "AttachItemID" && nv.Value?.ToString() == itemId.ToString()));
+        }
+
+        InventoryItem FindObjectItem(string name)
+        {
+            var c = GetClient();
+            var trash = c.Inventory.FindFolderForType(FolderType.Trash);
+            bool ok(InventoryBase b) => b is InventoryItem i && i.AssetType == AssetType.Object && i.Name == name && i.ParentUUID != trash;
+            // items taken or fetched in this session are in the local store; else ask the server for the Objects folder
+            var hit = c.Inventory.Store.Items.Values.Select(n => n.Data).FirstOrDefault(ok) as InventoryItem;
+            if (hit != null) return hit;
+            var folder = c.Inventory.FindFolderForType(AssetType.Object);
+            var list = c.Inventory.FolderContents(folder, c.Self.AgentID, true, true, InventorySortOrder.ByDate, TimeSpan.FromSeconds(30), true) ?? [];
+            return list.FirstOrDefault(ok) as InventoryItem;
+        }
+
+        /// <summary>Makes sure the bot wears its courier; builds it first if it does not exist. Returns the worn prim or null.</summary>
+        public (Primitive, string) EnsureCourier(bool mayBuild)
+        {
+            var c = GetClient();
+            var item = FindObjectItem(CourierName);
+            if (item == null)
+            {
+                if (!mayBuild) return (null, "the bot has no courier yet (use Send me a new HUD in the app once)");
+                var (box, why) = RezBox(CourierName, new Vector3(0.05f, 0.05f, 0.05f));
+                if (box == null) return (null, why);
+                var r = PutScript(box.LocalID, CourierName2, CourierScript, true);
+                if (!r.ok) return (null, "courier script: " + r.step + " " + string.Join(" ", r.messages));
+                c.Objects.SetPermissions(c.Network.CurrentSim, [box.LocalID], PermissionWho.NextOwner, PermissionMask.All, true);
+                item = Take(box.LocalID, CourierName);
+                if (item == null) return (null, "the courier did not arrive in the bot's inventory");
+            }
+            var worn = WornByItem(item.UUID);
+            if (worn != null) return (worn, "");
+            c.Appearance.Attach(item, AttachmentPoint.HUDBottomRight, false);
+            DateTime until = DateTime.Now.AddSeconds(20);
+            while (worn == null && DateTime.Now < until) { Thread.Sleep(500); worn = WornByItem(item.UUID); }
+            return worn == null ? (null, "the courier could not be worn") : (worn, "");
+        }
+
+        /// <summary>Puts the current HUD scripts (core + menu) and a fresh courier script into the worn courier.</summary>
+        (bool, string) LoadCourier(Primitive courier)
+        {
+            var c = GetClient();
+            string core = ReadFileFromEnv("SLBM_HUD_SCRIPT"), menu = ReadFileFromEnv("SLBM_HUD_MENU");
+            if (core == null || menu == null) return (false, "the HUD scripts were not found");
+            var inv = c.Inventory.GetTaskInventory(courier.ID, courier.LocalID, TimeSpan.FromSeconds(15)) ?? [];
+            foreach (var old in inv.OfType<InventoryItem>().Where(i => i.AssetType == AssetType.LSLText))
+                c.Inventory.RemoveTaskInventory(courier.LocalID, old.UUID, c.Network.CurrentSim);
+            if (inv.Count > 0) Thread.Sleep(1000);
+            var r1 = PutScript(courier.LocalID, HudMainScript, core, false);
+            if (!r1.ok) return (false, "HUD script did not compile: " + r1.step + " " + string.Join(" ", r1.messages));
+            var r2 = PutScript(courier.LocalID, HudMenuScript, menu, false);
+            if (!r2.ok) return (false, "HUD menu script did not compile: " + r2.step + " " + string.Join(" ", r2.messages));
+            var r3 = PutScript(courier.LocalID, CourierName2, CourierScript, true);
+            return r3.ok ? (true, "") : (false, "courier script: " + r3.step);
+        }
+
+        [About("Builds a new AvieBoter HUD (main prim + updater prim), gives it to an avatar and prepares the courier for updates")]
+        [ReturnHints("sent")]
+        [ArgHints("avatar", "who gets the HUD (name or UUID)", "AVATAR")]
+        [ArgHints("replyto", "none = answer directly; else where to send the result", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionMakeHud(string avatar, string replyto)
+        {
+            if (replyto == "app")
+            {
+                if (hudBusy == 1) return Failure("busy with another HUD job", [avatar]);
+                HudJob = "building";
+                Task.Run(() =>
+                {
+                    try { HudJob = MakeHud(avatar); } catch (Exception e) { HudJob = "error: " + e.Message; }
+                });
+                return BasicReply("started", [avatar]);
+            }
+            if (string.IsNullOrEmpty(replyto) || replyto == "none")
+            {
+                string r = MakeHud(avatar);
+                return r.StartsWith("sent") ? BasicReply(r, [avatar]) : Failure(r, [avatar]);
+            }
+            Task.Run(() =>
+            {
+                string r;
+                try { r = MakeHud(avatar); } catch (Exception e) { r = "error: " + e.Message; }
+                new Companion(master).Reply(replyto, "CompanionMakeHud", r);
+            });
+            return BasicReply("started", [avatar]);
+        }
+
+        string MakeHud(string avatar)
+        {
+            if (Interlocked.Exchange(ref hudBusy, 1) == 1) return "busy with another HUD job";
+            try
+            {
+                var c = GetClient();
+                string main = ReadFileFromEnv("SLBM_HUD_SCRIPT"), updater = ReadFileFromEnv("SLBM_HUD_UPDATER"), menu = ReadFileFromEnv("SLBM_HUD_MENU");
+                if (main == null || updater == null || menu == null) return "the HUD scripts were not passed to the bot (start it from AvieBoter)";
+                var (to, toName) = new Companion(master).ResolveAvatar(avatar);
+                if (to == UUID.Zero) return "avatar not found: " + avatar;
+                var (courier, cwhy) = EnsureCourier(true);
+                if (courier == null) return cwhy;
+                var (root, why) = RezBox(HudObjectName, new Vector3(0.02f, 0.09f, 0.09f));
+                if (root == null) return why;
+                var (helper, why2) = RezBox("SL Bot HUD updater", new Vector3(0.01f, 0.01f, 0.01f));
+                if (helper == null) return why2;
+                var r1 = PutScript(root.LocalID, HudMainScript, main, true);
+                if (!r1.ok) return "HUD script did not compile: " + r1.step + " " + string.Join(" ", r1.messages);
+                var r1b = PutScript(root.LocalID, HudMenuScript, menu, true);
+                if (!r1b.ok) return "HUD menu script did not compile: " + r1b.step + " " + string.Join(" ", r1b.messages);
+                var r2 = PutScript(helper.LocalID, HudUpdaterScript, updater, true);
+                if (!r2.ok) return "updater script did not compile: " + r2.step + " " + string.Join(" ", r2.messages);
+                // a one-shot script that pairs the HUD with this bot when it reaches its new owner, then deletes itself
+                string secret = Environment.GetEnvironmentVariable("commands_SharedSecret") ?? "";
+                string label = (Environment.GetEnvironmentVariable("SLBM_BOT_LABEL") ?? c.Self.Name).Replace("|", "/").Replace("\"", "'").Replace("\\", "/");
+                if (secret != "")
+                {
+                    string code = "SLB1|" + c.Self.AgentID + "|" + secret + "|" + label;
+                    var r3 = PutScript(root.LocalID, "SL Bot HUD pairing", PairingScript.Replace("@CODE@", code), true);
+                    if (!r3.ok) return "pairing script did not compile: " + r3.step + " " + string.Join(" ", r3.messages);
+                }
+                c.Objects.SetPermissions(c.Network.CurrentSim, [root.LocalID, helper.LocalID], PermissionWho.NextOwner, PermissionMask.All, true);
+                c.Objects.LinkPrims(c.Network.CurrentSim, [root.LocalID, helper.LocalID]);   // the first id becomes the root
+                Thread.Sleep(2000);
+                var item = Take(root.LocalID, HudObjectName);
+                if (item == null) return "the HUD did not arrive in the bot's inventory";
+                // wear it on the bot's HUD once and take it off again, so it remembers a HUD attachment point
+                c.Appearance.Attach(item, AttachmentPoint.HUDCenter2, false);
+                Thread.Sleep(5000);
+                c.Appearance.Detach(item);
+                Thread.Sleep(3000);
+                c.Inventory.GiveItem(item.UUID, item.Name, AssetType.Object, to, false);
+                LoadCourier(courier);
+                LogFormater.Info("[Companion] HUD " + VersionOf(main) + " sent to " + toName);
+                return "sent " + HudObjectName + " " + VersionOf(main) + " to " + toName;
+            }
+            finally { hudBusy = 0; }
+        }
+
+        [About("Switches automatic HUD updates on or off")]
+        [ReturnHints("on|off")]
+        [ArgHints("state", "on or off", "Text", "on")]
+        [CmdTypeSet()]
+        public object CompanionHudAutoUpdate(string state)
+        {
+            AutoUpdateOverride = !string.Equals(state, "off", StringComparison.OrdinalIgnoreCase);
+            return BasicReply(AutoUpdateOverride == true ? "on" : "off");
+        }
+
+        [About("The HUD reports its version; the bot updates it when it is older than the app's HUD")]
+        [ReturnHints("json {latest, action}")]
+        [ArgHints("version", "the HUD's version", "Text")]
+        [ArgHints("updater", "key of the HUD's updater prim, or none", "Text")]
+        [ArgHints("replyto", "the HUD's reply address", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionHudHello(string version, string updater, string replyto)
+        {
+            string latest = LatestHudVersion();
+            LastHudVersion = version ?? "";
+            CompanionEvents.Add("hud", CompanionAccess.LastCaller, CompanionAccess.LastCallerName, GetClient().Network.CurrentSim?.Name, version);
+            LastHudSeen = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
+            var c = GetClient();
+            string action = "current";
+            if (Older(version, latest))
+            {
+                bool auto = AutoUpdateOverride ?? Environment.GetEnvironmentVariable("SLBM_HUD_AUTOUPDATE") != "0";
+                if (!UUID.TryParse(updater ?? "", out UUID _)) action = "manual";      // a HUD without updater prim (or updater 1)
+                else if (Version.TryParse(version ?? "", out var hv) && hv < new Version(0, 6, 0)) action = "manual";   // before 0.6 only one script could be updated
+                else if (!auto) action = "off";
+                else if (string.IsNullOrEmpty(replyto) || replyto == "none" || !replyto.StartsWith("http")) action = "manual";
+                else
+                {
+                    action = "updating";
+                    Task.Run(() =>
+                    {
+                        string r;
+                        if (Interlocked.Exchange(ref hudBusy, 1) == 1) r = "busy";
+                        else
+                        {
+                            try
+                            {
+                                var (courier, why) = EnsureCourier(false);
+                                if (courier == null) r = why;
+                                else
+                                {
+                                    var (ok, why2) = LoadCourier(courier);
+                                    r = ok ? "ready" : why2;
+                                }
+                            }
+                            catch (Exception e) { r = "error: " + e.Message; }
+                            finally { hudBusy = 0; }
+                        }
+                        LogFormater.Info("[Companion] HUD update " + version + " -> " + latest + ": " + r);
+                        new Companion(master).Reply(replyto, "CompanionHudUpdate", r);
+                    });
+                }
+            }
+            return BasicReply(J(new { latest, action }), [version, updater]);
+        }
+
+        [About("Script errors and debug messages seen nearby (debug channel), after the given number")]
+        [ReturnHints("json {seq, items}")]
+        [ArgHints("after", "last number already read", "Number")]
+        [CmdTypeGet()]
+        public object CompanionDebugSince(string after)
+        {
+            long.TryParse(after, out long a);
+            return BasicReply(CompanionDebug.Since(a));
+        }
+    }
+
+    /// <summary>Keeps the last debug-channel messages (script errors) for CompanionDebugSince.</summary>
+    public static class CompanionDebug
+    {
+        static readonly object gate = new();
+        static readonly List<(long seq, long t, string from, string text)> items = new();
+        static long seq = 0;
+
+        public static void Note(ChatEventArgs e)
+        {
+            lock (gate)
+            {
+                items.Add((++seq, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), e.FromName ?? "", e.Message ?? ""));
+                if (items.Count > 200) items.RemoveRange(0, 50);
+            }
+        }
+
+        public static string Since(long after)
+        {
+            lock (gate)
+            {
+                if (after > seq) after = 0;
+                return System.Text.Json.JsonSerializer.Serialize(new
+                {
+                    seq,
+                    items = items.Where(i => i.seq > after).Select(i => new { seq = i.seq, t = i.t, from = i.from, text = i.text })
+                });
+            }
+        }
+    }
+}
