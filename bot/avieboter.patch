+// AvieBoter patch: building helpers so the app can make and update the HUD in-world
+// (rez a box, put scripts into objects, link, wear, take, give) and see script errors.
+using OpenMetaverse;
+using SecondBotEvents.Services;
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SecondBotEvents.Commands
+{
+    [ClassInfo("Building helpers used by the AvieBoter app (HUD making and updates)")]
+    public class CompanionBuild(EventsSecondBot setmaster) : CommandsAPI(setmaster)
+    {
+        static string J(object o) => System.Text.Json.JsonSerializer.Serialize(o, JsonOptions.UnsafeRelaxed);   // plain UTF-8 text for HUDs
+
+        [About("Rezzes a 0.5 m box in front of the bot, names it and returns its ids")]
+        [ReturnHints("json {localId, uuid}")]
+        [ReturnHintsFailure("no new object (no build rights here?)")]
+        [ArgHints("name", "name for the new box", "Text")]
+        [CmdTypeDo()]
+        public object CompanionRezBox(string name)
+        {
+            var (p, why) = RezBox(name);
+            if (p == null) return Failure(why, [name]);
+            return BasicReply(J(new { localId = p.LocalID, uuid = p.ID.ToString() }), [name]);
+        }
+
+        public (Primitive, string) RezBox(string name, Vector3? size = null)
+        {
+            var c = GetClient();
+            var sim = c.Network.CurrentSim;
+            if (sim == null) return (null, "not in a region");
+            Vector3 pos = c.Self.SimPosition + new Vector3(1.5f, 0f, 0.3f) * c.Self.Movement.BodyRotation;
+            Primitive found = null;
+            var before = new HashSet<uint>(sim.ObjectsPrimitives.Keys);
+            var alerts = new List<string>();
+            void upd(object s, PrimEventArgs e)
+            {
+                if (e.Prim.ParentID == 0 && (e.Prim.Flags & PrimFlags.CreateSelected) != 0 && !before.Contains(e.Prim.LocalID)
+                    && Vector3.Distance(e.Prim.Position, pos) < 5f) found ??= e.Prim;
+            }
+            void alert(object s, AlertMessageEventArgs e) { lock (alerts) alerts.Add(e.Message); }
+            c.Objects.ObjectUpdate += upd;
+            c.Self.AlertMessage += alert;
+            try
+            {
+                c.Objects.AddPrim(sim, ObjectManager.BuildBasicShape(PrimType.Box), UUID.Zero, pos, size ?? new Vector3(0.5f, 0.5f, 0.5f), Quaternion.Identity);
+                DateTime until = DateTime.Now.AddSeconds(12);
+                while (found == null && DateTime.Now < until) Thread.Sleep(250);
+            }
+            finally { c.Objects.ObjectUpdate -= upd; c.Self.AlertMessage -= alert; }
+            if (found == null)
+            {
+                string why = "the bot cannot build here" + (alerts.Count > 0 ? " (" + string.Join(" / ", alerts.Distinct()) + ")" : "");
+                LogFormater.Info("[Companion] rez failed: " + why);
+                return (null, why);
+            }
+            if (!string.IsNullOrWhiteSpace(name)) c.Objects.SetName(sim, found.LocalID, name);
+            LogFormater.Info("[Companion] rezzed box " + found.LocalID + " " + found.ID);
+            return (found, "");
+        }
+
+        [About("Links objects into one; the FIRST id becomes the root (checked in SL)")]
+        [ReturnHints("linked")]
+        [ArgHints("localIds", "local ids separated by commas, root first", "Text")]
+        [CmdTypeDo()]
+        public object CompanionLink(string localIds)
+        {
+            var ids = localIds.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(uint.Parse).ToList();
+            if (ids.Count < 2) return Failure("need two or more ids", [localIds]);
+            GetClient().Objects.LinkPrims(GetClient().Network.CurrentSim, ids);
+            Thread.Sleep(1500);
+            return BasicReply("linked", [localIds]);
+        }
+
+        [About("Creates a script from text, compiles it (Mono) and copies it into an object (rezzed or own attachment)")]
+        [ReturnHints("json {ok, messages}")]
+        [ArgHints("localId", "local id of the prim", "Number")]
+        [ArgHints("name", "script name", "Text")]
+        [ArgHints("base64", "script text, UTF-8, base64", "Text")]
+        [ArgHints("running", "true or false", "Text")]
+        [CmdTypeDo()]
+        public object CompanionTaskScript(string localId, string name, string base64, string running)
+        {
+            var r = PutScript(uint.Parse(localId), name, Encoding.UTF8.GetString(Convert.FromBase64String(base64)),
+                string.Equals(running, "true", StringComparison.OrdinalIgnoreCase));
+            return r.ok ? BasicReply(J(r), [localId, name]) : Failure(J(r), [localId, name]);
+        }
+
+        public record ScriptResult(bool ok, string step, List<string> messages, string itemId);
+
+        public ScriptResult PutScript(uint localId, string name, string text, bool running)
+        {
+            var c = GetClient();
+            var folder = c.Inventory.FindFolderForType(AssetType.LSLText);
+            InventoryItem item = null;
+            var made = new ManualResetEventSlim();
+            c.Inventory.RequestCreateItem(folder, name, "AvieBoter", AssetType.LSLText, UUID.Random(), InventoryType.LSL,
+                PermissionMask.All, (ok, it) => { if (ok) item = it; made.Set(); });
+            if (!made.Wait(20000) || item == null) return new ScriptResult(false, "create", [], "");
+            bool compiled = false; string status = ""; List<string> msgs = [];
+            var up = new ManualResetEventSlim();
+            c.Inventory.RequestUpdateScriptAgentInventory(Encoding.UTF8.GetBytes(text), item.UUID, true,
+                (uploadOk, uploadStatus, compileOk, messages, itemID, assetID) =>
+                {
+                    compiled = uploadOk && compileOk; status = uploadStatus; msgs = messages ?? [];
+                    up.Set();
+                });
+            if (!up.Wait(30000)) return new ScriptResult(false, "upload timeout", [], item.UUID.ToString());
+            if (!compiled) return new ScriptResult(false, "compile " + status, msgs, item.UUID.ToString());
+            Thread.Sleep(500);
+            if (c.Inventory.Store.Contains(item.UUID) && c.Inventory.Store[item.UUID] is InventoryItem fresh) item = fresh;
+            c.Inventory.CopyScriptToTask(localId, item, running);
+            Thread.Sleep(1500);
+            LogFormater.Info("[Companion] script " + name + " put into " + localId + (running ? " (running)" : " (not running)"));
+            return new ScriptResult(true, "copied", msgs, item.UUID.ToString());
+        }
+
+        [About("Lists the contents of an object")]
+        [ReturnHints("json [{name, type, id}]")]
+        [ArgHints("localId", "local id of the prim", "Number")]
+        [CmdTypeGet()]
+        public object CompanionTaskInventory(string localId)
+        {
+            var c = GetClient();
+            uint id = uint.Parse(localId);
+            if (!c.Network.CurrentSim.ObjectsPrimitives.TryGetValue(id, out Primitive p)) return Failure("object not seen", [localId]);
+            var list = c.Inventory.GetTaskInventory(p.ID, id, TimeSpan.FromSeconds(15)) ?? [];
+            return BasicReply(J(list.Select(i => new { name = i.Name, type = (i as InventoryItem)?.AssetType.ToString() ?? "folder", id = i.UUID.ToString(),
+                creator = (i as InventoryItem)?.CreatorID.ToString() ?? "" })), [localId]);
+        }
+
+        [About("Wears an object the bot owns that is rezzed nearby")]
+        [ReturnHints("attached")]
+        [ArgHints("localId", "local id of the root prim", "Number")]
+        [ArgHints("point", "attachment point name, e.g. Chest or HUDCenter", "Text")]
+        [CmdTypeDo()]
+        public object CompanionAttachObject(string localId, string point)
+        {
+            if (!Enum.TryParse(point, true, out AttachmentPoint ap)) return Failure("unknown point", [localId, point]);
+            // 0x80 = add to the point instead of replacing what is worn there
+            GetClient().Objects.AttachObject(GetClient().Network.CurrentSim, uint.Parse(localId), (AttachmentPoint)((byte)ap | 0x80), Quaternion.Identity);
+            Thread.Sleep(2000);
+            return BasicReply("attached", [localId, point]);
+        }
+
