+        static (Vector3 pos, bool onGround, string where) RezPlace(GridClient c, Simulator sim, string how)
+        {
+            var inv = System.Globalization.CultureInfo.InvariantCulture;
+            Vector3 front = c.Self.SimPosition + new Vector3(1.5f, 0f, 0.3f) * c.Self.Movement.BodyRotation;
+            switch ((how ?? "").Trim().ToLowerInvariant())
+            {
+                case "": case "front": return (front, false, "in front of the bot");
+                case "ground": return (front, true, "on the ground in front of the bot");
