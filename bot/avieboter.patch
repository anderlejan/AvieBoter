+        [About("What the bot wears now: attachments (with their points) and clothing / body parts")]
+        [ReturnHints("json {attachments:[{id,name,point}], wearables:[{id,name,type}]}")]
+        [CmdTypeGet()]
+        public object CompanionInvWorn()
