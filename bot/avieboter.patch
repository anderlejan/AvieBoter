+        string Follow(GridClient c, string target, string distance, string angle)
+        {
+            var inv = System.Globalization.CultureInfo.InvariantCulture;
+            if (string.Equals(target, "stop", StringComparison.OrdinalIgnoreCase))
+            {
+                bool was = followId != UUID.Zero;
+                StopFollow(c, "asked");
+                return was ? "stopped following" : "stopped (it was not following)";
+            }
+            UUID id;
+            if (string.Equals(target, "me", StringComparison.OrdinalIgnoreCase)) id = CompanionAccess.LastCaller;
+            else if (!UUID.TryParse(target, out id)) id = new Companion(master).ResolveAvatar(target).Item1;
+            if (id == UUID.Zero) return "could not tell whom to follow";
+            float.TryParse(distance, System.Globalization.NumberStyles.Float, inv, out float d);
+            float.TryParse(angle, System.Globalization.NumberStyles.Float, inv, out float a);
+            followDist = Math.Clamp(d <= 0 ? 2f : d, 0.5f, 20f);
+            followAngle = ((a % 360f) + 360f) % 360f;
+            bool fresh = followId != id;
+            followId = id;
+            followName = CompanionNames.Get(c, id, 3000);
+            if (followName == "") followName = id.ToString();
+            lostSince = DateTime.MinValue; lostAsks = 0; hintAt = DateTime.MinValue;
+            walking = false;                       // start afresh (a stuck walk from before must not block it)
+            tpTries = 0; offerWaitUntil = DateTime.MinValue;
+            movedAt = DateTime.Now; movedFrom = c.Self.SimPosition;
+            if (c.Self.SittingOn != 0) { c.Self.Stand(); Thread.Sleep(800); }
+            followTimer ??= new Timer(_ => FollowTick(), null, Timeout.Infinite, Timeout.Infinite);
+            followTimer.Change(200, 500);      // twice a second: flying is fast
+            if (fresh) CompanionEvents.Add("follow", id, followName, c.Network.CurrentSim?.Name, followDist + " m / " + followAngle + "°");
+            LogFormater.Info("[Companion] following " + followName + " at " + followDist + " m, " + followAngle + "°");
+            return "following " + followName + " – " + followDist.ToString("0.#", inv) + " m " + Where(followAngle);
+        }
+
+        static string Where(float a)
+        {
+            a = ((a % 360f) + 360f) % 360f;
+            if (a >= 135 && a <= 225) return "behind";
+            if (a < 45 || a > 315) return "in front";
+            return a < 180 ? "on the left" : "on the right";
+        }
+
+        static void FollowTick()
+        {
+            var c = radarClient;
+            if (c == null || followId == UUID.Zero) return;
+            try
+            {
+                var sim = c.Network.CurrentSim;
+                if (sim == null || c.Self.SittingOn != 0 || tpBusy == 1) return;
+                var t = CompanionRadarData.Find(c, followId);
+                if (t == null)
+                {
+                    var now = DateTime.Now;
+                    if (lostSince == DateTime.MinValue) { lostSince = now; lostAsks = 0; }
+                    // the HUD told where they went (a teleport beyond the radar): go there
+                    if (hintAt != DateTime.MinValue && now - hintAt < TimeSpan.FromMinutes(2) && hintHandle != sim.Handle
+                        && now - lastTp > TimeSpan.FromSeconds(15) && now >= offerWaitUntil)
+                    {
+                        if (tpTries < 2) LogFormater.Info("[Companion] follow: " + followName + " went to another region - teleporting after them");
+                        TeleportOrAsk(c, hintHandle, hintPos, "went to another region");
+                        return;
+                    }
+                    // no word from the HUD (an older HUD, or none): ask them for a teleport offer, twice at most
+                    if (now - lostSince > TimeSpan.FromSeconds(20) && lostAsks < 2 && now >= offerWaitUntil && now - askedAt > TimeSpan.FromMinutes(2))
+                    {
+                        lostAsks++;
+                        askedAt = now;
+                        offerWaitUntil = now + TimeSpan.FromSeconds(90);
+                        LogFormater.Info("[Companion] follow: lost sight of " + followName + " - asking for a teleport offer");
+                        c.Self.SendTeleportLureRequest(followId, "I am following you but lost you. Please offer me a teleport - I accept it.");
+                    }
+                    if (now - lostSince > TimeSpan.FromMinutes(10)) { CompanionEvents.Add("follow-lost", followId, followName, sim.Name); StopFollow(c, "lost sight for 10 minutes"); }
+                    return;
+                }
+                lostSince = DateTime.MinValue;
+                if (t.Handle == hintHandle) hintAt = DateTime.MinValue;   // seen where the HUD said: the hint is used up
+                Vector3 fwd = Vector3.UnitX * t.Rot;
+                double yaw = Math.Atan2(fwd.Y, fwd.X) + followAngle * Math.PI / 180.0;
+                Vector3 goal = t.Pos + new Vector3((float)Math.Cos(yaw) * followDist, (float)Math.Sin(yaw) * followDist, 0f);
+                // flying: aim where they will be in a moment, so the bot keeps the distance instead of trailing behind
+                bool theyFly = t.Precise && IsFlying(t.Id);
+                float theirSpeed = 0f;
+                if (t.Handle == sim.Handle)
+                {
+                    var av = sim.ObjectsAvatars.Values.FirstOrDefault(x => x.ID == t.Id);
+                    if (av != null)
+                    {
+                        theirSpeed = new Vector2(av.Velocity.X, av.Velocity.Y).Length();
+                        if (theyFly && av.Velocity.Length() > 1f) goal += av.Velocity * 0.8f;
+                        else if (theirSpeed > 1f) goal += new Vector3(av.Velocity.X, av.Velocity.Y, 0f) * 0.4f;
+                    }
+                }
+                var gGoal = CompanionRadarData.Global(t.Handle, goal);
+                var gMe = CompanionRadarData.Global(sim.Handle, c.Self.SimPosition);
+                double d2 = Math.Sqrt(Math.Pow(gGoal.X - gMe.X, 2) + Math.Pow(gGoal.Y - gMe.Y, 2));
+                double dz = goal.Z - c.Self.SimPosition.Z;
+                if (t.Handle == sim.Handle && d2 <= 10) { tpTries = 0; offerWaitUntil = DateTime.MinValue; }   // near again
+                if (t.Handle != sim.Handle || d2 > 40 || (t.Precise && Math.Abs(dz) > 30))
+                {
+                    if (DateTime.Now - lastTp < TimeSpan.FromSeconds(15)) return;
+                    Vector3 land = new(Math.Clamp(goal.X, 1f, 255f), Math.Clamp(goal.Y, 1f, 255f), t.Precise ? goal.Z : t.Pos.Z);
+                    TeleportOrAsk(c, t.Handle, land, t.Handle != sim.Handle ? "other region" : d2.ToString("0") + " m away");
+                    return;
+                }
+                bool meFly = c.Self.Movement.Fly;
+                // they run (walking is about 3.2 m/s, running about 5) or the bot fell behind: run; walk again when close
+                if (!meFly)
+                {
+                    bool run = theirSpeed > 3.6f || d2 > followDist + 4;
+                    bool walkAgain = theirSpeed < 3.0f && d2 < followDist + 1.5;
+                    if (run && !c.Self.Movement.AlwaysRun) { c.Self.Movement.AlwaysRun = true; c.Self.Movement.SendUpdate(true); }
+                    else if (walkAgain && c.Self.Movement.AlwaysRun) { c.Self.Movement.AlwaysRun = false; c.Self.Movement.SendUpdate(true); }
+                }
+                // they walk again (landed) and the bot still flies near them: stop flying - it drops down beside them
+                if (meFly && t.Precise && !theyFly && dz < -1.5 && d2 <= Math.Max(4.0, followDist + 2))
+                {
+                    if (walking) { c.Self.AutoPilotCancel(); walking = false; }
+                    c.Self.Fly(false);
+                    LogFormater.Info("[Companion] follow: " + followName + " landed - landing too");
+                    return;
+                }
+                if (d2 > 1.2 || (t.Precise && Math.Abs(dz) > 2.5))
+                {
+                    var now = DateTime.Now;
+                    if (!walking || Vector3.Distance(c.Self.SimPosition, movedFrom) > 0.5f) { movedFrom = c.Self.SimPosition; movedAt = now; }
+                    // not moved for 8 s while still more than 3 m away: blocked - teleport next to the target
+                    if (walking && now - movedAt > TimeSpan.FromSeconds(8) && d2 > 3 && now - lastTp > TimeSpan.FromSeconds(15))
+                    {
+                        if (now >= offerWaitUntil && tpTries < 2)
+                            LogFormater.Info("[Companion] follow: blocked " + d2.ToString("0.#") + " m from " + followName + " - teleporting next to them");
+                        c.Self.AutoPilotCancel();
+                        walking = false;
+                        movedAt = now;
+                        Vector3 near = new(Math.Clamp(goal.X, 1f, 255f), Math.Clamp(goal.Y, 1f, 255f), t.Precise ? goal.Z : t.Pos.Z);
+                        TeleportOrAsk(c, t.Handle, near, "blocked " + d2.ToString("0") + " m away");
+                        return;
+                    }
+                    // walk again when the goal moved, or every 5 s while not moving (the autopilot may have stopped)
+                    if (!walking || Vector3.Distance(goal, lastGoal) > 0.7f || (now - movedAt > TimeSpan.FromSeconds(3) && now - issuedAt > TimeSpan.FromSeconds(5)))
+                    {
+                        issuedAt = now;
+                        // fly while they fly or are clearly higher; flying down to someone on the ground keeps flying
+                        // until close (then the landing above takes over); never switch flying off in mid-air
+                        bool fly = t.Precise && (theyFly || dz > 2.5 || (meFly && dz < -2.5));
+                        if (fly != meFly) c.Self.Fly(fly);
+                        c.Self.AutoPilot(gGoal.X, gGoal.Y, t.Precise ? goal.Z : c.Self.SimPosition.Z);
+                        lastGoal = goal;
+                        walking = true;
+                    }
+                }
+                else if (walking)
+                {
+                    c.Self.AutoPilotCancel();
+                    walking = false;
+                    if (t.Handle == sim.Handle) c.Self.Movement.TurnToward(t.Pos);
+                }
+                if (!walking && theyFly && !c.Self.Movement.Fly) c.Self.Fly(true);      // hover with them, do not drop
+            }
+            catch (Exception e) { LogFormater.Warn("[Companion] follow: " + e.Message); }
+        }
+
+        [About("The HUD says where its wearer is after a region change; a bot following them teleports there when it lost them")]
+        [ReturnHints("ok or not following you")]
+        [ArgHints("cornerx", "the region's corner x (metres on the grid)", "Number")]
+        [ArgHints("cornery", "the region's corner y", "Number")]
+        [ArgHints("x", "position in the region", "Number")]
+        [ArgHints("y", "position in the region", "Number")]
+        [ArgHints("z", "position in the region", "Number")]
+        [CmdTypeDo()]
+        public object CompanionImHere(string cornerx, string cornery, string x, string y, string z)
+        {
+            if (followId == UUID.Zero || CompanionAccess.LastCaller != followId) return BasicReply("not following you");
+            var inv = System.Globalization.CultureInfo.InvariantCulture;
+            var ns = System.Globalization.NumberStyles.Float;
+            if (!uint.TryParse(cornerx, out uint cx) || !uint.TryParse(cornery, out uint cy)) return Failure("bad region corner");
+            float.TryParse(x, ns, inv, out float px); float.TryParse(y, ns, inv, out float py); float.TryParse(z, ns, inv, out float pz);
+            hintPos = new Vector3(Math.Max(px, 1f), Math.Max(py, 1f), Math.Max(pz, 0f));   // no upper clamp: OpenSim regions can be bigger
+            hintHandle = Utils.UIntsToLong(cx, cy);
+            hintAt = DateTime.Now;
+            return BasicReply("ok");
+        }
+
+        [About("Goes to an avatar near the bot (walks if close, else teleports, then walks the rest)")]
+        [ReturnHints("result text")]
+        [ArgHints("avatar", "avatar UUID", "UUID")]
+        [ArgHints("replyto", "none or where to send the result", "SMART")]
+        [CmdTypeDo()]
+        public object CompanionGoTo(string avatar, string replyto)
+        {
+            var c = GetClient();
+            if (!UUID.TryParse(avatar, out UUID id)) return Failure("bad uuid", [avatar]);
+            var t = CompanionRadarData.Find(c, id);
+            if (t == null) return Failure("that avatar is not on the radar", [avatar]);
+            var comp = new Companion(master);
+            Task.Run(() =>
+            {
+                string r;
+                try { r = comp.JoinFor(t.Handle, t.Pos, UUID.Zero, UUID.Zero, replyto); } catch (Exception e) { r = "error: " + e.Message; }
+                LogFormater.Info("[Companion] go to " + t.Name + ": " + r);
+                if (!string.IsNullOrEmpty(replyto) && replyto != "none") comp.Reply(replyto, "CompanionGoTo", r);
+            });
+            return BasicReply("started", [avatar]);
+        }
+    }
+}
