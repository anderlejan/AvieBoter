+            if (a == "on" || a == "off") CompanionMenuStore.SetAutoAnim(a == "on");
+            return BasicReply(CompanionMenuStore.AutoAnim ? "on" : "off", [state]);
+        }
+
+        [About("The animations the bot plays now (names for the built-in ones, else keys) – to check what objects play on it")]
+        [ReturnHints("json [{id, name}]")]
+        [CmdTypeGet()]
+        public object CompanionAnims()
+        {
+            var names = typeof(Animations).GetFields(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Static)
+                .Where(f => f.FieldType == typeof(UUID)).GroupBy(f => (UUID)f.GetValue(null)).ToDictionary(g => g.Key, g => g.First().Name.ToLowerInvariant());
+            var list = GetClient().Self.SignaledAnimations.Copy().Keys.Select(k => new { id = k.ToString(), name = names.TryGetValue(k, out var n) ? n : "" }).ToList();
+            return BasicReply(J(list));
+        }
+
+        [About("Touchable objects within 20 m of the bot for the HUD's Touch menu: one line each, local id|metres|name, nearest first (at most 18)")]
+        [ReturnHints("text lines lid|m|name, or nothing found")]
+        [CmdTypeGet()]
+        public object CompanionTouchList()
+        {
+            var c = GetClient();
+            var sim = c.Network.CurrentSim;
+            if (sim == null) return Failure("not in a region");
+            Vector3 me = c.Self.SimPosition;
+            var list = sim.ObjectsPrimitives.Values.Where(p => p.ParentID == 0 && !p.IsAttachment && (p.Flags & PrimFlags.Touch) != 0 && Vector3.Distance(me, p.Position) <= 20)
+                .OrderBy(p => Vector3.Distance(me, p.Position)).Take(18).ToList();
+            Props(sim, list, 3000);
+            if (list.Count == 0) return BasicReply("nothing to touch within 20 m");
+            // a HUD button holds 24 bytes and a HUD gets at most 2 KB: short plain names
+            static string Short(string n)
+            {
+                var t = new string((n ?? "").Where(ch => ch >= ' ' && ch < 127 && ch != '|').ToArray()).Trim();
+                if (t == "") t = "Object";
+                return t.Length > 19 ? t[..19] : t;
+            }
+            return BasicReply(string.Join("\n", list.Select(p => p.LocalID + "|" + Math.Round(Vector3.Distance(me, p.Position)) + "|" + Short(p.Properties?.Name))));
+        }
+
+        [About("Answers a menu (button), a text box (the text) or a permission question (yes / no); !!close!! ignores it")]
+        [ReturnHints("answered")]
+        [ArgHints("id", "the menu's number from CompanionMenus", "Number")]
+        [ArgHints("answer", "the button, the text, yes / no, or !!close!! (= ignore, nothing is sent)", "Text")]
+        [CmdTypeDo()]
+        public object CompanionMenuAnswer(string id, string answer)
+        {
+            if (!long.TryParse(id, out long n)) return Failure("which menu?", [id]);
+            string r = CompanionMenuStore.Answer(GetClient(), n, answer ?? "");
+            return r.StartsWith("!") ? Failure(r[1..], [id]) : BasicReply(r, [id]);
+        }
+    }
+
+    /// <summary>AvieBoter patch: keeps what objects ask the bot (dialogs, text boxes, permissions, links) until the
+    /// app answers it or it is 10 minutes old.</summary>
+    public static class CompanionMenuStore
+    {
+        class Entry
+        {
+            public long id { get; set; }
+            public long t { get; set; }
+            public string kind { get; set; }
+            public string @object { get; set; }
+            public string objectId { get; set; }
+            public string owner { get; set; }
+            public string message { get; set; }
+            public List<string> buttons { get; set; }
+            public List<string> perms { get; set; }
+            public string url { get; set; }
+            public bool debit { get; set; }
+            internal int channel;
+            internal UUID objId, itemId;
+            internal Simulator sim;
+            internal ScriptPermission asked;
+        }
+
+        static readonly object gate = new();
+        static readonly List<Entry> items = new();
+        static long next = 0;
+        static GridClient attached;
+
+        public static void Attach(GridClient c)
+        {
+            lock (gate)
+            {
+                if (ReferenceEquals(attached, c)) return;
+                if (attached != null)
+                {
+                    attached.Self.ScriptDialog -= OnDialog;
+                    attached.Self.ScriptQuestion -= OnQuestion;
+                    attached.Self.LoadURL -= OnUrl;
+                }
+                attached = c;
+                items.Clear();
+                c.Self.ScriptDialog += OnDialog;
+                c.Self.ScriptQuestion += OnQuestion;
+                c.Self.LoadURL += OnUrl;
+            }
+        }
+
+        static void Add(Entry e)
+        {
+            lock (gate)
+            {
+                e.id = ++next;
+                e.t = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
+                // a new menu from the same object on the same channel replaces the older one, as in a viewer
+                if (e.kind is "menu" or "text") items.RemoveAll(x => x.objId == e.objId && x.channel == e.channel && x.kind is "menu" or "text");
+                items.Add(e);
+                if (items.Count > 30) items.RemoveAt(0);
+            }
+            ToHud(e);
+        }
+
+        // ---- the same menus on the HUD of the person who uses the bot (as a blue menu there, answered back by IM) ----
+        const string HudOffFile = "menus-hud-off.txt";
+        public static bool ToHudOn = !System.IO.File.Exists(HudOffFile);
+        static readonly System.Net.Http.HttpClient http = new() { Timeout = TimeSpan.FromSeconds(20) };
+
+        public static void SetToHud(bool on)
+        {
+            ToHudOn = on;
+            try { if (on) System.IO.File.Delete(HudOffFile); else System.IO.File.WriteAllText(HudOffFile, "off"); } catch { }
+        }
+
+        /// <summary>The HUD address of whoever used the bot last (else the HUD seen most recently, at most 2 days ago).</summary>
+        static string HudUrl()
+        {
+            if (CompanionAccess.LastCaller != UUID.Zero && CompanionAccess.HudUrls.TryGetValue(CompanionAccess.LastCaller, out var me)) return me.url;
+            var best = CompanionAccess.HudUrls.Values.OrderByDescending(v => v.seen).FirstOrDefault();
+            return best.url != null && DateTime.Now - best.seen < TimeSpan.FromDays(2) ? best.url : null;
+        }
+
+        static string Cut(string t, int n) => t == null ? "" : t.Length <= n ? t : t[..n] + "…";
+
+        static void ToHud(Entry e)
+        {
+            if (!ToHudOn || attached == null) return;
+            string url = HudUrl();
+            if (string.IsNullOrEmpty(url)) return;
+            // an LSL script gets at most 2048 bytes of a request: keep it short
+            string json = JsonSerializer.Serialize(new
+            {
+                bot = attached.Self.AgentID.ToString(), id = e.id,
+                k = e.kind == "permission" ? "perm" : e.kind,
+                o = Cut(e.@object, 40),
+                m = e.kind == "permission" ? Cut(string.Join(", ", e.perms ?? []), 300) + (e.debit ? " - and to take Linden dollars!" : "") : Cut(e.message, 350),
+                b = (e.buttons ?? []).Select(x => Cut(x, 24)).ToList(),
+                u = e.kind == "url" ? Cut(e.url, 255) : null
+            }, JsonOptions.UnsafeRelaxed);
+            try
+            {
+                var content = new System.Net.Http.StringContent("c|CompanionMenu\n" + json, System.Text.Encoding.UTF8, "text/plain");
+                _ = http.PostAsync(url, content).ContinueWith(t => { if (t.IsFaulted) LogFormater.Info("[Companion] menu to the HUD: no answer"); });
+            }
+            catch { }
+        }
+
+        static void OnDialog(object s, ScriptDialogEventArgs e)
+        {
+            bool text = e.ButtonLabels.Count == 1 && e.ButtonLabels[0] == "!!llTextBox!!";
+            string owner = (e.FirstName + " " + e.LastName).Trim();
+            if (e.OwnerID != UUID.Zero) CompanionNames.Note(e.OwnerID, owner);
+            Add(new Entry
+            {
+                kind = text ? "text" : "menu", @object = e.ObjectName ?? "", objectId = e.ObjectID.ToString(), owner = owner,
+                message = e.Message ?? "", buttons = text ? [] : e.ButtonLabels.ToList(), channel = e.Channel, objId = e.ObjectID
+            });
+        }
+
+        // ---- permission questions answered without asking ----
+        // Animation sequences (dance balls, couples' animations, poses) often ask again for every animation; a viewer's
+        // user clicks each time, but a bot would stall after the first one. So: asking only to animate the bot is
+        // allowed at once (switch: CompanionAutoAnim), and an object the user already allowed gets the same again.
+        const string AnimAskFile = "anims-ask.txt";
+        public static bool AutoAnim = !System.IO.File.Exists(AnimAskFile);
+        public static void SetAutoAnim(bool on)
+        {
+            AutoAnim = on;
+            try { if (on) System.IO.File.Delete(AnimAskFile); else System.IO.File.WriteAllText(AnimAskFile, "ask"); } catch { }
+        }
+        static readonly System.Collections.Concurrent.ConcurrentDictionary<UUID, (ScriptPermission perms, DateTime until)> allowedBefore = new();
+
+        static void OnQuestion(object s, ScriptQuestionEventArgs e)
+        {
+            bool animOnly = e.Questions == ScriptPermission.TriggerAnimation;
+            bool again = allowedBefore.TryGetValue(e.TaskID, out var was) && DateTime.Now < was.until && (e.Questions & ~was.perms) == 0;
+            if ((AutoAnim && animOnly) || again)
+            {
+                attached?.Self.ScriptQuestionReply(e.Simulator, e.ItemID, e.TaskID, e.Questions);
+                allowedBefore[e.TaskID] = (e.Questions | (again ? was.perms : 0), DateTime.Now.AddHours(2));
+                LogFormater.Info("[Companion] allowed '" + e.ObjectName + "' " + e.Questions + (again ? " (allowed before)" : " (animations are allowed without asking)"));
+                return;
+            }
+            var names = Enum.GetValues<ScriptPermission>().Where(p => p != ScriptPermission.None && (e.Questions & p) != 0).Select(p => p.ToString()).ToList();
+            Add(new Entry
+            {
+                kind = "permission", @object = e.ObjectName ?? "", objectId = e.TaskID.ToString(), owner = e.ObjectOwnerName ?? "",
+                message = "", buttons = [], perms = names, debit = (e.Questions & ScriptPermission.Debit) != 0,
+                objId = e.TaskID, itemId = e.ItemID, sim = e.Simulator, asked = e.Questions
+            });
+        }
+
+        static void OnUrl(object s, LoadUrlEventArgs e)
+        {
+            Add(new Entry
+            {
+                kind = "url", @object = e.ObjectName ?? "", objectId = e.ObjectID.ToString(),
+                owner = e.OwnerIsGroup ? "(group)" : CompanionNames.Get(attached, e.OwnerID), message = e.Message ?? "",
+                buttons = [], url = e.URL ?? "", objId = e.ObjectID
+            });
+        }
+
+        public static string List()
+        {
+            lock (gate)
+            {
+                long old = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - 10 * 60 * 1000;
+                items.RemoveAll(x => x.t < old);
+                return JsonSerializer.Serialize(items, JsonOptions.UnsafeRelaxed);
+            }
+        }
+
+        // "!!b<n>" = the n-th button (the app and HUD 1.7.6 send that: labels like "• Dance All • |||120" hold "|||",
+        // which a command cannot carry); else the label, also when spaces, bullets or "|||" got lost on the way
+        static int Button(Entry e, string answer)
+        {
+            var m = System.Text.RegularExpressions.Regex.Match(answer ?? "", @"^!!b(\d+)$");
+            if (m.Success) { int n = int.Parse(m.Groups[1].Value); return n < e.buttons.Count ? n : -1; }
+            int i = e.buttons.IndexOf(answer);
+            if (i >= 0) return i;
+            string a = Norm(answer);
+            if (a == "") return -1;
+            i = e.buttons.FindIndex(b => Norm(b) == a);
+            if (i >= 0) return i;
+            string an = Alnum(answer);
+            if (an != "") { i = e.buttons.FindIndex(b => Alnum(b) == an); if (i >= 0) return i; }
+            return e.buttons.FindIndex(b => Norm(b).StartsWith(a, StringComparison.Ordinal));     // a label the HUD shortened
+        }
+        static string Alnum(string x) => System.Text.RegularExpressions.Regex.Replace(x ?? "", @"[^\p{L}\p{N}]", "").ToLowerInvariant();
+
+        static string Norm(string x) => System.Text.RegularExpressions.Regex.Replace(x ?? "", @"\s+", " ").Trim().TrimEnd('…');
+
+        public static string Answer(GridClient c, long id, string answer)
+        {
+            Entry e;
+            lock (gate)
+            {
+                e = items.FirstOrDefault(x => x.id == id);
+                if (e == null) return "!that menu is gone (answered or too old)";
+                // a menu button: find it before the menu is taken away (a wrong answer must not lose the menu)
+                if (e.kind == "menu" && answer != "!!close!!" && Button(e, answer) < 0)
+                {
+                    LogFormater.Info("[Companion] menu of '" + e.@object + "': no button '" + answer + "'");
+                    return "!no such button";
+                }
+                items.Remove(e);
+            }
+            if (answer == "!!close!!") return "closed";      // ignored, as a viewer's Ignore button: nothing is sent
+            string a = answer.Trim();
+            switch (e.kind)
+            {
+                case "menu":
+                    {
+                        // the exact label goes back (dance balls pad labels with spaces and codes, e.g. " Dance All   122";
+                        // a HUD or a command may have lost the padding)
+                        int i = Button(e, answer);
+                        c.Self.ReplyToScriptDialog(e.channel, i, e.buttons[i], e.objId);
+                        LogFormater.Info("[Companion] menu of '" + e.@object + "': chose '" + e.buttons[i] + "'");
+                        return "chose " + e.buttons[i].Trim();
+                    }
+                case "text":
+                    c.Self.ReplyToScriptDialog(e.channel, 0, answer, e.objId);
+                    return "sent";
+                case "permission":
+                    {
+                        bool yes = a.Equals("yes", StringComparison.OrdinalIgnoreCase);
+                        c.Self.ScriptQuestionReply(e.sim ?? c.Network.CurrentSim, e.itemId, e.objId, yes ? e.asked : ScriptPermission.None);
+                        if (yes) allowedBefore[e.objId] = (e.asked, DateTime.Now.AddHours(2));     // the same object asks again: no new question
+                        return yes ? "allowed" : "refused";
+                    }
+            }
+            return "closed";
+        }
+    }
+}
