+
+        [About("Whether objects may animate the bot without asking (on / off / ask = tell). Objects the user allowed once get the same again for two hours either way.")]
+        [ReturnHints("on or off")]
+        [ArgHints("state", "on, off or ask", "Text", "ask")]
+        [CmdTypeDo()]
+        public object CompanionAutoAnim(string state)
+        {
