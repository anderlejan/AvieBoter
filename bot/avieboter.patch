+        /// <summary>Takes a rezzed object into inventory and returns the new item (or null). The region announces the new
+        /// item with BulkUpdateInventory, which LibreMetaverse only puts into its local store (no ItemReceived event).</summary>
+        public InventoryItem Take(uint localId, string name)
+        {
+            var c = GetClient();
+            InventoryItem got = null;
+            var known = new HashSet<UUID>(c.Inventory.Store.Items.Keys);
+            void added(object s, InventoryObjectAddedEventArgs e) => Check(e.Obj);
+            void updated(object s, InventoryObjectUpdatedEventArgs e) => Check(e.NewObject);
+            void Check(InventoryBase o)
+            {
+                if (o is InventoryItem i && i.AssetType == AssetType.Object && !known.Contains(i.UUID)
+                    && (string.IsNullOrEmpty(name) || i.Name == name)) got ??= i;
+            }
+            c.Inventory.Store.InventoryObjectAdded += added;
+            c.Inventory.Store.InventoryObjectUpdated += updated;
+            try
+            {
+                c.Inventory.RequestDeRezToInventory(localId);
+                DateTime until = DateTime.Now.AddSeconds(60);
+                while (got == null && DateTime.Now < until) Thread.Sleep(500);
+            }
+            finally
+            {
+                c.Inventory.Store.InventoryObjectAdded -= added;
+                c.Inventory.Store.InventoryObjectUpdated -= updated;
+            }
+            LogFormater.Info(got != null ? "[Companion] took " + got.Name + " into inventory" : "[Companion] take: '" + name + "' did not arrive");
+            return got;
+        }
