+namespace SecondBotEvents.Commands
+{
+    /// <summary>AvieBoter patch: keeps the last chat lines and IMs for the app (CompanionChatSince).</summary>
+    public static class CompanionChat
+    {
+        class Entry
+        {
+            public long seq { get; set; }
+            public long t { get; set; }
+            public string kind { get; set; }
+            public string from { get; set; }
+            public string fromId { get; set; }
+            public string text { get; set; }
+            public string session { get; set; }
+        }
+
+        static readonly object gate = new();
+        static readonly List<Entry> items = new();
+        static long seq = 0;
+        static GridClient attached;
+        static readonly HashSet<UUID> leftSessions = new();
+        /// <summary>true = leave conference chats at once (env SLBM_LEAVE_CONFERENCES=1 at start, or CompanionConferences).</summary>
+        public static bool LeaveConferences = Environment.GetEnvironmentVariable("SLBM_LEAVE_CONFERENCES") == "1";
+
+        public static void Attach(GridClient c)
+        {
+            lock (gate)
+            {
+                if (ReferenceEquals(attached, c)) return;
+                if (attached != null)
+                {
+                    attached.Self.ChatFromSimulator -= OnChat;
+                    attached.Self.IM -= OnIM;
+                }
+                attached = c;
+                c.Self.ChatFromSimulator += OnChat;
+                c.Self.IM += OnIM;
+                CompanionPeople.Attach(c);
+                CompanionMenuStore.Attach(c);
+                StartCameraFollower(c);
+            }
+        }
+
+        static void Add(string kind, string from, UUID fromId, string text, UUID session)
+        {
+            if (string.IsNullOrWhiteSpace(text)) return;
+            lock (gate)
+            {
+                items.Add(new Entry { seq = ++seq, t = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), kind = kind, from = from ?? "",
+                    fromId = fromId.ToString(), text = text, session = session == UUID.Zero ? "" : session.ToString() });
+                if (items.Count > 600) items.RemoveRange(0, 100);
+            }
+        }
+
+        static void OnChat(object sender, ChatEventArgs e)
+        {
+            if (e.Type == ChatType.Debug) { CompanionDebug.Note(e); return; }
+            if (e.Type == ChatType.StartTyping || e.Type == ChatType.StopTyping) return;
+            if (e.AudibleLevel == ChatAudibleLevel.Not) return;
+            if (e.Message != null && (e.Message.Contains("<bridgeURL>") || e.Message.StartsWith("<bridge"))) return;   // viewer bridge, not chat
+            string kind = e.SourceType == ChatSourceType.System ? "system"
+                : e.SourceType == ChatSourceType.Object ? (e.Type == ChatType.OwnerSay ? "ownersay" : "object")
+                : e.Type == ChatType.Whisper ? "whisper" : e.Type == ChatType.Shout ? "shout" : "local";
+            Add(kind, e.FromName, e.SourceID, e.Message, UUID.Zero);
+        }
+
+        static void OnIM(object sender, InstantMessageEventArgs e)
+        {
+            var im = e.IM;
+            switch (im.Dialog)
+            {
+                case InstantMessageDialog.StartTyping:
+                case InstantMessageDialog.StopTyping:
+                    return;
+                case InstantMessageDialog.MessageFromObject:
+                    // signed commands from the HUD are not conversation
+                    if (im.Message != null && im.Message.Contains("@@@") && im.Message.Contains(";|;")) return;
+                    Add("objectim", im.FromAgentName, im.FromAgentID, im.Message, UUID.Zero);
+                    return;
+                case InstantMessageDialog.MessageFromAgent:
+                    Add("im", im.FromAgentName, im.FromAgentID, im.Message, im.IMSessionID);
+                    return;
+                case InstantMessageDialog.SessionSend:
+                    if (!im.GroupIM && LeaveConferences)
+                    {
+                        // conference chats are switched off for this bot: leave once, record nothing
+                        lock (gate)
+                        {
+                            if (!leftSessions.Add(im.IMSessionID)) return;
+                        }
+                        try { attached?.Self.RequestLeaveGroupChat(im.IMSessionID); } catch { }
+                        LogFormater.Info("[Companion] left a conference chat started by " + im.FromAgentName + " (conferences are off)");
+                        return;
+                    }
+                    Add(im.GroupIM ? "group" : "conference", im.FromAgentName, im.FromAgentID, im.Message, im.IMSessionID);
+                    return;
+                default:
+                    Add("notice", im.FromAgentName, im.FromAgentID, im.Dialog + ": " + im.Message, im.IMSessionID);
+                    return;
+            }
+        }
+
+        static Timer cameraTimer;
+        /// <summary>The app's Nearby list may look further than the usual 64 m for a while (the region then sends the
+        /// objects up to this distance); the follower puts the camera's reach back afterwards.</summary>
+        public static float WideFar = 64f;
+        public static DateTime WideUntil = DateTime.MinValue;
+
+        /// <summary>LibreMetaverse moves the camera only when the bot turns; after a login or teleport it stays behind and
+        /// the region then sends the objects around the old spot. Keep it on the bot so nearby objects (vehicles) are known.</summary>
+        static void StartCameraFollower(GridClient c)
+        {
+            cameraTimer?.Dispose();
+            cameraTimer = new Timer(_ =>
+            {
+                try
+                {
+                    if (c.Network?.CurrentSim == null) return;
+                    var cam = c.Self.Movement.Camera;
+                    Vector3 eye = c.Self.SimPosition + new Vector3(0f, 0f, 1.5f);
+                    float far = DateTime.Now < WideUntil ? WideFar : 64f;
+                    if (Vector3.Distance(cam.Position, eye) > 2f || cam.Far != far)
+                    {
+                        cam.Position = eye;
+                        cam.Far = far;
+                    }
+                }
+                catch { }
+            }, null, 1000, 1000);
+        }
+
+        public static string Since(long after)
+        {
+            lock (gate)
+            {
+                if (after > seq) after = 0;   // the bot program restarted
+                var list = items.Where(i => i.seq > after).Take(200).ToList();
+                return System.Text.Json.JsonSerializer.Serialize(new { seq, items = list });
+            }
+        }
+    }
+}
