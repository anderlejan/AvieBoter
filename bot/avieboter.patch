+// AvieBoter patch: sharing the bot (who may use it with a HUD), a log of who comes and goes, radar, following
+// and walking (used when a teleport is rerouted to a landing point or refused).
+using OpenMetaverse;
+using SecondBotEvents.Services;
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net.Http;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace SecondBotEvents.Commands
+{
+    /// <summary>Names of avatars by key, filled from what the bot sees and from name lookups.</summary>
+    public static class CompanionNames
+    {
+        static readonly ConcurrentDictionary<UUID, string> names = new();
+        static readonly ConcurrentDictionary<UUID, DateTime> asked = new();
+        static GridClient hooked;
+
+        public static void Hook(GridClient c)
+        {
+            if (hooked == c) return;
+            hooked = c;
+            c.Avatars.UUIDNameReply += (s, e) => { foreach (var kv in e.Names) names[kv.Key] = kv.Value; };
+        }
+
+        public static void Note(UUID id, string name) { if (id != UUID.Zero && !string.IsNullOrWhiteSpace(name)) names[id] = name; }
+
+        public static string Get(GridClient c, UUID id, int waitMs = 0)
+        {
+            if (names.TryGetValue(id, out string n)) return n;
+            if (c != null && (!asked.TryGetValue(id, out DateTime t) || DateTime.Now - t > TimeSpan.FromMinutes(2)))
+            {
+                asked[id] = DateTime.Now;
+                Hook(c);
+                c.Avatars.RequestAvatarName(id);
+            }
+            DateTime until = DateTime.Now.AddMilliseconds(waitMs);
+            while (DateTime.Now < until)
+            {
+                Thread.Sleep(100);
+                if (names.TryGetValue(id, out n)) return n;
+            }
+            return "";
+        }
+
+        /// <summary>Avatar key from a name: names seen before, then the people search (waits up to waitMs).</summary>
+        public static UUID Find(GridClient c, string name, int waitMs)
+        {
+            if (UUID.TryParse(name ?? "", out UUID id)) return id;
+            string want = Norm(name);
+            foreach (var kv in names) if (Norm(kv.Value) == want) return kv.Key;
+            var (hid, _, _) = CompanionAccess.FindHud(name);
+            if (hid != UUID.Zero) return hid;
+            if (c == null) return UUID.Zero;
+            UUID q = UUID.Random(), found = UUID.Zero;
+            using var done = new ManualResetEventSlim(false);
+            EventHandler<AvatarPickerReplyEventArgs> h = (s, e) =>
+            {
+                if (e.QueryID != q) return;
+                foreach (var kv in e.Avatars) { names[kv.Key] = kv.Value; if (Norm(kv.Value) == want) found = kv.Key; }
+                done.Set();
+            };
+            c.Avatars.AvatarPickerReply += h;
+            try { c.Avatars.RequestAvatarNameSearch(name.Trim(), q); done.Wait(waitMs); }
+            finally { c.Avatars.AvatarPickerReply -= h; }
+            return found;
+        }
+
+        public static string Norm(string n)
+        {
+            n = (n ?? "").Trim().ToLowerInvariant().Replace('.', ' ');
+            if (n.EndsWith(" resident")) n = n[..^9];
+            return n;
+        }
+    }
+
+    /// <summary>Who comes and goes: radar arrivals/departures, HUDs saying hello/bye, people starting to use the bot.
+    /// The app reads them with CompanionEventsSince and writes them to bots\&lt;id&gt;\events\events-YYYY-MM-DD.jsonl.</summary>
+    public static class CompanionEvents
+    {
+        static readonly object gate = new();
+        static readonly List<(long seq, string json)> items = new();
+        static long seq = 0;
+
+        public static void Add(string type, UUID who, string name, string region, string extra = "")
+        {
+            lock (gate)
+            {
+                ++seq;
+                string json = System.Text.Json.JsonSerializer.Serialize(new
+                {
+                    seq,
+                    t = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(),
+                    type,
+                    uuid = who == UUID.Zero ? "" : who.ToString(),
+                    name = name ?? "",
+                    region = region ?? "",
+                    extra = extra ?? ""
+                });
+                items.Add((seq, json));
+                if (items.Count > 1000) items.RemoveRange(0, 200);
+            }
+        }
+
+        public static string Since(long after)
+        {
+            lock (gate)
+            {
+                if (after > seq) after = 0;
+                return "{\"seq\":" + seq + ",\"items\":[" + string.Join(",", items.Where(i => i.seq > after).Select(i => i.json)) + "]}";
+            }
+        }
+    }
+
+    /// <summary>Who may use the bot with a HUD. The app passes the bot's people (SLBM_PEOPLE, names separated by
+    /// commas) and updates them live with CompanionSetPeople. A signed HUD command is only accepted when the HUD's
+    /// owner is one of them; an empty list accepts every correctly signed HUD (as before 0.7).</summary>
+    public static class CompanionAccess
+    {
+        static HashSet<string> people = Parse(Environment.GetEnvironmentVariable("SLBM_PEOPLE"));
+        static readonly ConcurrentDictionary<UUID, DateTime> lastUse = new();
+        public static UUID LastCaller = UUID.Zero;
+        public static string LastCallerName = "";
+
+        static HashSet<string> Parse(string csv) =>
+            new((csv ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(CompanionNames.Norm).Where(n => n != ""));
+
+        public static void Set(string csv) { people = Parse(csv); }
+
+        /// <summary>The last reply address (the HUD's web address) of each person's HUD, with when it was seen.</summary>
+        public static readonly ConcurrentDictionary<UUID, (string url, string name, DateTime seen)> HudUrls = new();
+
+        static void NoteHudUrl(UUID ownerId, string name, string message)
+        {
+            int a = message.IndexOf("#|#"), b = message.IndexOf("@@@");
+            if (a < 0 || b < a) return;
+            string url = message.Substring(a + 3, b - a - 3);
+            if (url.StartsWith("http://") || url.StartsWith("https://")) HudUrls[ownerId] = (url, name, DateTime.Now);
+        }
+
+        public static bool IsPerson(string name) => people.Count == 0 || people.Contains(CompanionNames.Norm(name));
+
+        /// <summary>The known HUD address of an avatar given by name or UUID.</summary>
+        public static (UUID id, string url, double ageSec) FindHud(string avatar)
+        {
+            foreach (var kv in HudUrls)
+                if (kv.Key.ToString() == (avatar ?? "").Trim() || CompanionNames.Norm(kv.Value.name) == CompanionNames.Norm(avatar ?? ""))
+                    return (kv.Key, kv.Value.url, (DateTime.Now - kv.Value.seen).TotalSeconds);
+            return (UUID.Zero, "", -1);
+        }
+        public static int Count => people.Count;
+
+        /// <summary>Called for every instant message from an object; ownerId = the object's owner.</summary>
+        public static bool ObjectOwnerAllowed(GridClient c, UUID ownerId, string message)
+        {
+            if (!(message ?? "").Contains("@@@")) return true;     // not a signed command: SecondBot rejects it anyway
+            if (ownerId == UUID.Zero) return people.Count == 0;
+            string name = CompanionNames.Get(c, ownerId, people.Count == 0 ? 0 : 5000);
+            bool ok = people.Count == 0 || (name != "" && people.Contains(CompanionNames.Norm(name)));
+            string cmd = (message ?? "").Split(new[] { "|||", "#|#", "@@@" }, StringSplitOptions.None)[0];
+            if (!ok)
+            {
+                if (!lastUse.TryGetValue(ownerId, out DateTime t) || DateTime.Now - t > TimeSpan.FromMinutes(5))
+                    CompanionEvents.Add("refused", ownerId, name, c.Network.CurrentSim?.Name, cmd);
+                lastUse[ownerId] = DateTime.Now;
+                LogFormater.Warn("[Companion] refused a HUD command from " + (name == "" ? ownerId.ToString() : name) + " (not one of the bot's people)");
+                return false;
+            }
+            LastCaller = ownerId;
+            LastCallerName = name;
+            NoteHudUrl(ownerId, name, message);
+            if (!lastUse.TryGetValue(ownerId, out DateTime last) || DateTime.Now - last > TimeSpan.FromMinutes(10))
+                CompanionEvents.Add("use", ownerId, name, c.Network.CurrentSim?.Name, cmd);
+            lastUse[ownerId] = DateTime.Now;
+            return true;
+        }
+    }
