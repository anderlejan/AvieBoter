+        /// <summary>Makes sure the bot wears its courier; builds it first if it does not exist. Returns the worn prim or null.</summary>
+        public (Primitive, string) EnsureCourier(bool mayBuild)
+        {
+            var c = GetClient();
+            var item = FindObjectItem(CourierName);
+            if (item == null)
+            {
+                if (!mayBuild) return (null, "the bot has no courier yet (use Send me a new HUD in the app once)");
+                var (box, why) = RezBox(CourierName, new Vector3(0.05f, 0.05f, 0.05f));
+                if (box == null) return (null, why);
+                var r = PutScript(box.LocalID, CourierName2, CourierScript, true);
+                if (!r.ok) return (null, "courier script: " + r.step + " " + string.Join(" ", r.messages));
+                c.Objects.SetPermissions(c.Network.CurrentSim, [box.LocalID], PermissionWho.NextOwner, PermissionMask.All, true);
+                item = Take(box.LocalID, CourierName);
+                if (item == null) return (null, "the courier did not arrive in the bot's inventory");
