+            if (ids.Length == 0) return;
+            foreach (var chunk in ids.Chunk(100)) c.Objects.SelectObjects(sim, chunk, true);
+            DateTime until = DateTime.Now.AddMilliseconds(waitMs);
+            while (DateTime.Now < until && prims.Any(p => p.Properties == null)) Thread.Sleep(150);
+            foreach (var chunk in ids.Chunk(100)) c.Objects.DeselectObjects(sim, chunk);
+        }
+
+        /// <summary>An object by its local id, or by its key (UUID) – then also a single prim of a linked object, as when
+        /// you touch one button of it in a viewer. Only objects the region has sent the bot can be found.</summary>
+        Primitive Root(Simulator sim, string localId)
+        {
+            if (sim == null) return null;
