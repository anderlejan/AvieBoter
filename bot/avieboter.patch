+// AvieBoter patch: the bot's groups for the app's Groups section (list, roles and titles, members, and the actions a
+// group member can take: activate, title, notices, invite, eject, roles, notice, join, leave), plus Undeform.
+using OpenMetaverse;
+using SecondBotEvents.Services;
+using System;
+using System.Collections.Concurrent;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading;
+
+namespace SecondBotEvents.Commands
+{
+    [ClassInfo("Groups for the AvieBoter app's Groups section")]
+    public class CompanionGroups(EventsSecondBot setmaster) : CommandsAPI(setmaster)
+    {
+        static string J(object o) => System.Text.Json.JsonSerializer.Serialize(o);
+
+        /// <summary>Asks the grid and waits for the matching event (or the timeout); returns what the event gave.</summary>
+        static T Ask<T>(Action<EventHandler<T>> add, Action<EventHandler<T>> remove, Action request, Func<T, bool> mine, int ms = 10000) where T : EventArgs
+        {
+            T got = null;
+            using var done = new ManualResetEventSlim(false);
+            EventHandler<T> h = (s, e) => { if (mine(e)) { got = e; done.Set(); } };
+            add(h);
+            try { request(); done.Wait(ms); }
+            finally { remove(h); }
+            return got;
+        }
+
+        static bool Has(GroupPowers p, GroupPowers want) => (p & want) == want;
+
+        Dictionary<UUID, Group> CurrentGroups(GridClient c)
+        {
+            var e = Ask<CurrentGroupsEventArgs>(h => c.Groups.CurrentGroups += h, h => c.Groups.CurrentGroups -= h,
+                () => c.Groups.RequestCurrentGroups(), _ => true);
+            return e?.Groups ?? new Dictionary<UUID, Group>();
+        }
+
+        [About("The bot's groups: name, key, active, own powers, notices and profile settings")]
+        [ReturnHints("json [{id, name, active, ...}]")]
+        [CmdTypeGet()]
+        public object CompanionGroupList()
+        {
+            var c = GetClient();
+            var groups = CurrentGroups(c);
+            var active = c.Self.ActiveGroup;
+            var list = groups.Values.OrderBy(g => g.Name, StringComparer.OrdinalIgnoreCase).Select(g => new
+            {
+                id = g.ID.ToString(), name = g.Name, active = g.ID == active, notices = g.AcceptNotices, profile = g.ListInProfile,
+                insignia = g.InsigniaID.ToString(),
+                canInvite = Has(g.Powers, GroupPowers.Invite), canEject = Has(g.Powers, GroupPowers.Eject),
+                canNotice = Has(g.Powers, GroupPowers.SendNotices),
+                canRoles = Has(g.Powers, GroupPowers.AssignMember) || Has(g.Powers, GroupPowers.AssignMemberLimited),
+                canRemoveRoles = Has(g.Powers, GroupPowers.RemoveMember)
+            }).ToList();
+            return BasicReply(J(new { active = active.ToString(), groups = list }));
+        }
+
+        [About("Roles, titles and members of one of the bot's groups (members with names, at most 'max')")]
+        [ReturnHints("json {roles, titles, members, memberCount}")]
+        [ArgHints("group", "group key", "UUID")]
+        [ArgHints("max", "most members to list (names are looked up)", "Number", "500")]
+        [CmdTypeGet()]
+        public object CompanionGroupDetail(string group, string max)
+        {
+            if (!UUID.TryParse(group, out UUID g)) return Failure("bad group key", [group]);
+            if (!int.TryParse(max, out int most) || most <= 0) most = 500;
+            var c = GetClient();
+            UUID req = UUID.Zero;
+            var roles = Ask<GroupRolesDataReplyEventArgs>(h => c.Groups.GroupRoleDataReply += h, h => c.Groups.GroupRoleDataReply -= h,
+                () => req = c.Groups.RequestGroupRoles(g), e => e.GroupID == g);
+            var titles = Ask<GroupTitlesReplyEventArgs>(h => c.Groups.GroupTitlesReply += h, h => c.Groups.GroupTitlesReply -= h,
+                () => c.Groups.RequestGroupTitles(g), e => e.GroupID == g);
+            var members = Ask<GroupMembersReplyEventArgs>(h => c.Groups.GroupMembersReply += h, h => c.Groups.GroupMembersReply -= h,
+                () => c.Groups.RequestGroupMembers(g), e => e.GroupID == g, 20000);
+            var rm = Ask<GroupRolesMembersReplyEventArgs>(h => c.Groups.GroupRoleMembersReply += h, h => c.Groups.GroupRoleMembersReply -= h,
+                () => c.Groups.RequestGroupRolesMembers(g), e => e.GroupID == g, 15000);
+            if (roles == null && members == null) return Failure("no answer from the grid about this group", [group]);
+            var byMember = new Dictionary<UUID, List<string>>();
+            foreach (var kv in rm?.RolesMembers ?? new List<KeyValuePair<UUID, UUID>>())
+            {
+                if (!byMember.TryGetValue(kv.Value, out var l)) byMember[kv.Value] = l = new List<string>();
+                l.Add(kv.Key.ToString());
+            }
+            var all = (members?.Members.Values ?? Enumerable.Empty<GroupMember>())
+                .OrderBy(m => m.OnlineStatus == "Online" ? 0 : 1).ThenBy(m => m.OnlineStatus).Take(most).ToList();
+            var ids = all.Select(m => m.ID).ToList();
+            foreach (var chunk in ids.Where(i => CompanionNames.Get(null, i) == "").Chunk(80)) { CompanionNames.Hook(c); c.Avatars.RequestAvatarNames(chunk.ToList()); }
+            DateTime until = DateTime.Now.AddSeconds(8);
+            while (DateTime.Now < until && ids.Any(i => CompanionNames.Get(null, i) == "")) Thread.Sleep(200);
+            return BasicReply(J(new
+            {
+                memberCount = members?.Members.Count ?? 0,
+                roles = (roles?.Roles.Values ?? Enumerable.Empty<GroupRole>()).OrderBy(r => r.ID == UUID.Zero ? 0 : 1).ThenBy(r => r.Name)
+                    .Select(r => new { id = r.ID.ToString(), name = r.ID == UUID.Zero ? "Everyone" : r.Name, title = r.Title, description = r.Description }),
