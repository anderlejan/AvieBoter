+        /// <summary>The bot's one anchor item: the remembered one, else one found from earlier (the others go to the Trash),
+        /// else a new one if the bot may build here. Null if there is none and none can be made.</summary>
+        InventoryItem AnchorItem(bool mayBuild, out string how)
+        {
+            lock (anchorGate)
+            {
+                var c = GetClient();
+                var sim = c?.Network?.CurrentSim;
+                how = "";
+                if (sim == null) { how = "offline"; return null; }
+                var trash = c.Inventory.FindFolderForType(FolderType.Trash);
+                InventoryItem kept = null;
+                if (System.IO.File.Exists(AnchorFile) && UUID.TryParse(System.IO.File.ReadAllText(AnchorFile).Trim(), out UUID id))
+                {
+                    var it = c.Inventory.FetchItem(id, c.Self.AgentID, TimeSpan.FromSeconds(10));
+                    if (it != null && it.ParentUUID == trash)
+                    {
+                        // deleted by accident (still in the Trash): bring it back instead of making another
+                        c.Inventory.MoveItem(it.UUID, c.Inventory.FindFolderForType(AssetType.Object));
+                        it.ParentUUID = c.Inventory.FindFolderForType(AssetType.Object);
+                        LogFormater.Info("[Companion] the camera anchor was in the Trash - put back");
+                    }
+                    if (it != null) { kept = it; how = "known"; }
+                    // gone for good (Trash emptied): it is made again below where the bot may build
+                }
+                if (kept == null || !anchorTidied)
+                {
+                    // copies from earlier versions anywhere in the inventory (not in the Trash): keep one, the rest to the Trash
+                    var all = AllItems(trash, out var cofLinks);
+                    var found = all.Where(i => i.AssetType == AssetType.Object && AnchorNames.Contains(i.Name) && i.CreatorID == c.Self.AgentID && i.UUID != kept?.UUID).ToList();
+                    if (kept == null && found.Count > 0) { kept = found.OrderByDescending(i => i.CreationDate).First(); found.Remove(kept); how = "found"; }
+                    foreach (var extra in found)
+                    {
+                        c.Appearance.Detach(extra);
+                        foreach (var link in cofLinks.Where(l => l.AssetUUID == extra.UUID)) c.Inventory.RemoveItem(link.UUID);   // its outfit link
+                        c.Inventory.MoveItem(extra.UUID, trash);
+                        LogFormater.Info("[Companion] an extra camera anchor went to the Trash");
+                    }
+                    anchorTidied = true;
+                }
+                if (kept == null)
+                {
+                    if (!mayBuild) { how = "none yet"; return null; }
+                    var (box, why) = RezBox(AnchorName, new Vector3(0.01f, 0.01f, 0.01f));
+                    if (box == null) { how = "none yet (" + why + ")"; return null; }
+                    Thread.Sleep(1000);
+                    c.Objects.SetName(sim, box.LocalID, AnchorName);     // once more: the first can be lost while the box is new
+                    var te = new Primitive.TextureEntry(new UUID("8dcd4a48-2d37-4909-9f78-f7a9eb4ef903"));   // transparent
+                    te.DefaultTexture.RGBA = new Color4(1f, 1f, 1f, 0f);
+                    c.Objects.SetTextures(sim, box.LocalID, te);
+                    Thread.Sleep(1500);
+                    kept = Take(box.LocalID, AnchorName);
+                    if (kept == null) { how = "none yet (it did not arrive in inventory)"; return null; }
+                    how = "made";
+                    LogFormater.Info("[Companion] made the camera anchor");
+                }
+                if (kept.Name != AnchorName) { c.Inventory.MoveItem(kept.UUID, kept.ParentUUID, AnchorName); kept.Name = AnchorName; }
+                try { System.IO.File.WriteAllText(AnchorFile, kept.UUID.ToString()); } catch { }
+                return kept;
+            }
+        }
