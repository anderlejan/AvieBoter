+namespace SecondBotEvents.Commands
+{
+    /// <summary>Group invitations wait here for an answer from the app (AvieBoter does not let SecondBot decline them
+    /// at once any more when it does not accept them by itself).</summary>
+    public static class CompanionGroupInvitations
+    {
+        public class Invite { public UUID Group; public UUID Session; public string From = ""; public string Message = ""; public long At; }
+        static readonly ConcurrentDictionary<UUID, Invite> open = new();
+        static GridClient hooked;
+
+        public static void Hook(GridClient c)
+        {
+            if (c == null || hooked == c) return;
+            hooked = c;
+            c.Self.IM += (s, e) =>
+            {
+                if (e.IM.Dialog != InstantMessageDialog.GroupInvitation) return;
+                var inv = new Invite { Group = e.IM.FromAgentID, Session = e.IM.IMSessionID, From = e.IM.FromAgentName ?? "", Message = e.IM.Message ?? "", At = DateTimeOffset.UtcNow.ToUnixTimeSeconds() };
+                open[inv.Group] = inv;
+                LogFormater.Info("[Companion] group invitation waits for an answer in the app: " + inv.Message);
+                CompanionEvents.Add("group-invite", inv.Group, inv.From, c.Network.CurrentSim?.Name ?? "", inv.Message.Length > 200 ? inv.Message[..200] : inv.Message);
+            };
+        }
+
+        public static List<Invite> List() => open.Values.OrderByDescending(i => i.At).ToList();
+        public static Invite Take(UUID g) => open.TryRemove(g, out Invite i) ? i : null;
+    }
+}
