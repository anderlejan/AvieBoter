+        /// <summary>Called for every instant message from an object; ownerId = the object's owner.</summary>
+        public static bool ObjectOwnerAllowed(GridClient c, UUID ownerId, string message)
+        {
+            if (!(message ?? "").Contains("@@@")) return true;     // not a signed command: SecondBot rejects it anyway
+            if (ownerId == UUID.Zero) return people.Count == 0;
+            string name = CompanionNames.Get(c, ownerId, people.Count == 0 ? 0 : 5000);
+            bool ok = people.Count == 0 || (name != "" && people.Contains(CompanionNames.Norm(name)));
+            string cmd = (message ?? "").Split(new[] { "|||", "#|#", "@@@" }, StringSplitOptions.None)[0];
+            if (!ok)
+            {
+                if (!lastUse.TryGetValue(ownerId, out DateTime t) || DateTime.Now - t > TimeSpan.FromMinutes(5))
+                    CompanionEvents.Add("refused", ownerId, name, c.Network.CurrentSim?.Name, cmd);
+                lastUse[ownerId] = DateTime.Now;
+                LogFormater.Warn("[Companion] refused a HUD command from " + (name == "" ? ownerId.ToString() : name) + " (not one of the bot's people)");
+                return false;
+            }
+            LastCaller = ownerId;
+            LastCallerName = name;
+            NoteHudUrl(ownerId, name, message);
+            if (!lastUse.TryGetValue(ownerId, out DateTime last) || DateTime.Now - last > TimeSpan.FromMinutes(10))
+                CompanionEvents.Add("use", ownerId, name, c.Network.CurrentSim?.Name, cmd);
+            lastUse[ownerId] = DateTime.Now;
+            return true;
+        }
+    }
