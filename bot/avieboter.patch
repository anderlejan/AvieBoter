+        static void NoteHudUrl(UUID ownerId, string name, string message)
+        {
+            int a = message.IndexOf("#|#"), b = message.IndexOf("@@@");
+            if (a < 0 || b < a) return;
+            string url = message.Substring(a + 3, b - a - 3);
+            if (!url.StartsWith("http://") && !url.StartsWith("https://")) return;
+            bool changed = !HudUrls.TryGetValue(ownerId, out var old) || old.url != url;
+            HudUrls[ownerId] = (url, name, DateTime.Now);
+            if (changed || DateTime.Now - hudUrlsSaved > TimeSpan.FromMinutes(30)) SaveHudUrls();
+        }
