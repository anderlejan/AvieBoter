+        /// <summary>Teleports towards the target, or - after two teleports that did not help - asks the target for a
+        /// teleport offer once and waits 90 s for it (offers from the bot's people are accepted automatically).</summary>
+        static void TeleportOrAsk(GridClient c, ulong handle, Vector3 land, string why)
+        {
+            var now = DateTime.Now;
+            if (now < offerWaitUntil) return;                       // waiting for the offer
+            if (tpTries >= 2)
+            {
+                if (now - askedAt < TimeSpan.FromMinutes(2)) return;
+                askedAt = now;
+                offerWaitUntil = now + TimeSpan.FromSeconds(90);
+                tpTries = 0;
+                LogFormater.Info("[Companion] follow: teleports did not bring me to " + followName + " (" + why + ") - asking for a teleport offer");
+                c.Self.SendTeleportLureRequest(followId, "I am following you but cannot get to you by myself. Please offer me a teleport - I accept it.");
+                return;
+            }
+            tpTries++;
+            lastTp = now; movedAt = now;
+            walking = false;
+            tpBusy = 1;
+            Task.Run(() => { try { c.Self.Teleport(handle, land); } catch { } finally { tpBusy = 0; } });
