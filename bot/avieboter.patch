+            messages = msgs;
+            return why;
+        }
+
+        [About("Makes a new notecard or script in a folder of the bot's inventory")]
+        [ReturnHints("json {id, name} of the new item")]
+        [ArgHints("kind", "notecard or script", "Text")]
