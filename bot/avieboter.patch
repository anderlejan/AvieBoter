+        static void SaveHudUrls()
+        {
+            try
+            {
+                hudUrlsSaved = DateTime.Now;
+                System.IO.File.WriteAllLines(HudUrlFile, HudUrls.Select(kv => kv.Key + "\t" + kv.Value.url + "\t" + (kv.Value.name ?? "").Replace("\t", " ") + "\t" + kv.Value.seen.ToUniversalTime().Ticks));
+            }
+            catch { }
+        }
