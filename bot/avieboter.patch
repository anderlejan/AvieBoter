+        /// <summary>Saves the text of a notecard or script in the bot's inventory; for a script also gives the compile messages.</summary>
+        public string SaveText(UUID itemId, bool script, string text, out List<string> messages)
+        {
+            var c = GetClient();
+            var msgs = new List<string>();
+            string why = "the save did not answer";
+            using (var done = new ManualResetEventSlim())
+            {
+                if (script)
