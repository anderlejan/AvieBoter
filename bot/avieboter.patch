+        [CmdTypeDo()]
+        public object CompanionYoungAlert(string days)
+        {
+            int.TryParse(days, out int d);
+            CompanionAges.YoungDays = Math.Max(0, d);
+            var c = GetClient();
+            var sim = c?.Network?.CurrentSim;
+            if (CompanionAges.YoungDays > 0 && sim != null)      // switched on: also the avatars already here
+                foreach (var id in sim.AvatarPositions.Keys.Where(k => k != c.Self.AgentID).Take(40)) CompanionAges.Arrived(c, id, CompanionNames.Get(null, id), sim.Name);
+            return BasicReply(CompanionAges.YoungDays > 0 ? "alert under " + CompanionAges.YoungDays + " days" : "off");
+        }
+
+        [About("Undeform: stops every animation the bot plays (not while it sits) and sends its appearance again (rebakes), so viewers redraw it")]
+        [ReturnHints("result text")]
+        [CmdTypeDo()]
+        public object CompanionUndeform()
+        {
+            var c = GetClient();
+            const string tip = " – a viewer that still shows it deformed: right-click the bot → Reset skeleton";
+            if (c.Self.SittingOn != 0)
+            {
+                // a passenger keeps its seat's animations (stopping them would leave it standing on the seat)
+                c.Appearance.RequestSetAppearance(true);
+                LogFormater.Info("[Companion] undeform (seated): appearance sent again, animations kept");
+                return BasicReply("the bot sits, so its seat's animations were kept; appearance sent again (stand it up first for a full undeform)" + tip);
+            }
+            var anims = c.Self.SignaledAnimations.Copy().Keys.ToList();
+            foreach (var a in anims) c.Self.AnimationStop(a, true);
+            c.Self.AnimationStart(Animations.STAND, true); Thread.Sleep(300); c.Self.AnimationStop(Animations.STAND, true);
