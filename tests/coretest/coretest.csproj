<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks the manager's storage code (no window needed): settings and bot lists survive save/load, NaN included. -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup><Compile Include="..\..\manager\Core\Models.cs;..\..\manager\Core\JsonStore.cs;..\..\manager\Core\Log.cs;..\..\manager\Core\AppPaths.cs;..\..\manager\Core\BotReply.cs;..\..\manager\Core\Secrets.cs" /></ItemGroup>
  <ItemGroup><PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" /></ItemGroup>
  <ItemGroup><None Include="samples\*.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
</Project>
